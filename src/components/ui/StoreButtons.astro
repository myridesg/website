---
import { Image } from 'astro:assets'
import { ANDROID_LIVE, IOS_LIVE, IOS_TESTING_HREF, STORE, TESTFLIGHT } from '@/consts'
import appStoreBadgeBlack from '@/assets/badges/app-store-badge-black.svg'
import appStoreBadgeWhite from '@/assets/badges/app-store-badge-white.svg'
import googlePlayBadge from '@/assets/badges/google-play-badge.png'

interface Props {
  /** 'dark' sits on a light surface; 'light' sits on a dark surface. */
  tone?: 'dark' | 'light'
  /**
   * Centres the buttons and the note under them. A prop rather than a
   * `justify-center` passed in `class`, because the root is no longer the
   * button row — that class would land on a column and do nothing.
   */
  center?: boolean
  class?: string
}

const { tone = 'dark', center = false, class: className = '' } = Astro.props

// Both listings are published, so the two stores carry equal weight — neither
// platform should read as the preferred one. The web app button is gone: that
// product is switched off, and the page it now serves only tells the reader to
// come back to a store.
//
// Both buttons are always rendered, so a crawler and a reader without
// JavaScript see the pair. BaseLayout hides the irrelevant one on a phone it
// recognises — see the platform script there.
//
// The iOS branch below falls back to the public TestFlight build rather than
// disappearing, so pulling IOS_LIVE leaves a working destination instead of a
// hole. Same for Android.
const onDark = tone === 'light'

// /45 measured 4.47:1 on #080808 — a hair under AA for 13px text. /55 is 6.27:1.
const note = onDark ? 'text-white/55' : 'text-muted'
const noteLink = onDark ? 'text-on-dark' : 'text-ink'

const base =
  'inline-flex min-h-12 items-center rounded-pill px-7 text-md font-semibold transition-opacity'

// Fallback-only button styling. The store links themselves are the official
// badge artwork, which carries its own surface, so they get just the shared
// hover treatment.
const secondary = onDark
  ? 'border border-white/25 text-on-dark hover:bg-white/10'
  : 'border border-ink/15 hover:bg-soft'

// Badges render at a 48px visible height, matching the min-h-12 text buttons
// they replaced and comfortably above Apple's 40px minimum. Both are given
// explicit width and height so the row reserves its space before the images
// arrive.
//
//   Apple   — official SVG is full-bleed at 119.66407 × 40, so 48px tall is
//             119.66407 × 48 / 40 = 143.60px wide; rounded to 144 (a 0.3%
//             stretch that no eye will find).
//   Google  — the official PNG ships 646 × 250 with a transparent margin; the
//             file in src/assets/badges/ is cropped to its visible 564 × 168,
//             so 48px tall is 564 × 48 / 168 = 161.14px wide; rounded to 161.
//             The Image is served at twice that (322 × 96) and pulled back to
//             a 48px box with h-12 w-auto, so it stays sharp on retina screens
//             without the layout box ever moving. (Astro 7's <Image> has no
//             density prop — the 2x-serve/CSS-pin pair is the equivalent.)
const APPLE_W = 144
const GOOGLE_W = 161

// Apple's guidelines offer the badge in black and white; the black badge goes
// on light surfaces and the white one on dark, which is what `tone` tracks.
const appStoreBadge = onDark ? appStoreBadgeWhite : appStoreBadgeBlack
---

<div class:list={['flex flex-col', center && 'items-center text-center', className]}>
  <div class:list={['flex flex-wrap items-center gap-3', center && 'justify-center']}>
    {
      ANDROID_LIVE && (
        <a
          href={STORE.android}
          data-store="android"
          class="inline-flex transition-opacity hover:opacity-85"
        >
          <Image
            src={googlePlayBadge}
            alt="Get it on Google Play"
            width={GOOGLE_W * 2}
            height={96}
            class="h-12 w-auto"
            loading="eager"
          />
        </a>
      )
    }

    {
      IOS_LIVE ? (
        <a
          href={STORE.ios}
          data-store="ios"
          class="inline-flex transition-opacity hover:opacity-85"
        >
          <Image
            src={appStoreBadge}
            alt="Download on the App Store"
            width={APPLE_W}
            height={48}
            loading="eager"
          />
        </a>
      ) : (
        <a href={TESTFLIGHT} class:list={[base, secondary]} data-store="ios">
          iPhone — TestFlight
        </a>
      )
    }

  </div>

  {
    !IOS_LIVE && (
      /* TestFlight needs Apple's testing app installed before the link does
         anything, which is not obvious to someone who has never used it — and
         a public link can fill up or be closed, hence the email fallback. */
      <p class:list={['mt-4 text-sm leading-relaxed', note]}>
        The App Store listing is still in review. Install TestFlight from the
        App Store, then open the link above — or, if the build is full,{' '}
        <a
          href={IOS_TESTING_HREF}
          class:list={['font-semibold underline underline-offset-4', noteLink]}
        >
          email us to join the testing community
        </a>
        .
      </p>
    )
  }
</div>
