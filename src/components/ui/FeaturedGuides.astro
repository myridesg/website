---
import { listGuideArticles, getGuideArticle } from '@/content/usecases'
import { contentRepo } from '@/lib/content'

// These links depend on this build's content, not the production sitemap.
// A fresh checkout with no Sanity configuration renders no missing guide links.
const preferred = [
  'motorcycle-maintenance-singapore',
  'motorcycle-oil-change-singapore',
  'motorcycle-chain-maintenance-singapore',
]
const summaries = await listGuideArticles(contentRepo)
const selected = preferred.flatMap((slug) => summaries.filter((guide) => guide.slug === slug))
const fetched = await Promise.all(selected.map((guide) => getGuideArticle(contentRepo, guide.slug)))
const guides = fetched.filter((guide) => guide !== null && !guide.seo.noIndex)
---

{guides.length > 0 && (
  <section class="bg-soft py-20 md:py-28" aria-labelledby="maintenance-reading-title">
    <div class="shell">
      <div class="max-w-2xl">
        <h2 id="maintenance-reading-title" class="text-display-sm md:text-display">
          Keep learning about your motorcycle.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink/75">
          Explore maintenance guides, then keep a record of the work you do in MyRideSG.
        </p>
      </div>
      <ul class="mt-10 grid gap-8 md:grid-cols-3">
        {guides.map((guide) => (
          <li class="border-t border-ink/15 pt-6">
            <h3 class="text-2xl">
              <a href={`/guides/${guide!.slug}/`} class="hover:text-red underline underline-offset-4">
                {guide!.title}
              </a>
            </h3>
            <p class="mt-3 leading-relaxed text-ink/75">{guide!.description}</p>
          </li>
        ))}
      </ul>
      <a href="/guides/" class="mt-9 inline-block text-red underline underline-offset-4">
        Browse all riding guides
      </a>
    </div>
  </section>
)}
