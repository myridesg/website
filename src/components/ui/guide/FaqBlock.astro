---
/**
 * `faq` block from the Sanity article body: each question as a heading with
 * its answer under it, all showing, as Wise's guides do. No accordion.
 *
 * The FAQPage structured data is not emitted here: a page has one JSON-LD
 * graph, and guides/[slug].astro builds the FAQPage into it from
 * faqItemsOf(), the same function that decides which questions show below.
 */
import { PortableText } from 'astro-portabletext'
import type { PortableTextProps } from 'astro-portabletext/types'
import { faqItemsOf } from '@/lib/guides'

interface FaqItem {
  question?: string
  answer?: PortableTextProps['value']
}

interface Props {
  node: { items?: FaqItem[] }
}

const { node } = Astro.props

// Only questions with an answer, so the page shows exactly what the FAQPage
// data says.
const answered = new Set(faqItemsOf([{ _type: 'faq', ...node }]).map((item) => item.q))
const items = (node.items ?? []).filter((item): item is FaqItem & { question: string } =>
  Boolean(item?.question && answered.has(item.question)),
)
---

{
  items.length > 0 && (
    <section class="guide-faq">
      {items.map((item) => (
        <div class="guide-faq__item">
          <h3>{item.question}</h3>
          <div class="guide-faq__answer">
            <PortableText value={item.answer ?? []} />
          </div>
        </div>
      ))}
    </section>
  )
}
