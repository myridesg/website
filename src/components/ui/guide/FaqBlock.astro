---
/**
 * `faq` block from the Sanity article body.
 *
 * The studio accordion (studio.css, as FeatureFaq): native <details> sharing
 * one name per block, so one answer is open at a time, each row with the
 * ring-and-plus mark.
 *
 * Also emits FAQPage structured data, as the home page does: these guides exist
 * to be found, and it is the cleanest format for search and AI crawlers to
 * extract.
 */
import { PortableText } from 'astro-portabletext'
import type { PortableTextProps } from 'astro-portabletext/types'

interface FaqItem {
  question?: string
  answer?: PortableTextProps['value']
}

interface Props {
  node: { _key?: string; items?: FaqItem[] }
}

const { node } = Astro.props
// One group per block (Portable Text gives every block a _key), so two FAQ
// blocks in one article don't close each other's answers.
const group = `faq-${node._key ?? 'block'}`

const items = (node.items ?? []).filter((item): item is FaqItem & { question: string } =>
  Boolean(item?.question),
)

/**
 * Flattens Portable Text spans to a plain string for the JSON-LD answer.
 * schema.org wants text, and structured data that disagrees with the visible
 * answer is worse than none — so this reads the same nodes the markup renders
 * rather than a separately authored summary.
 */
function toPlainText(value: unknown): string {
  if (!Array.isArray(value)) return ''
  return value
    .map((block: any) =>
      block?._type === 'block' && Array.isArray(block.children)
        ? block.children.map((child: any) => child?.text ?? '').join('')
        : '',
    )
    .filter(Boolean)
    .join('\n\n')
}

const answered = items
  .map((item) => ({ question: item.question, text: toPlainText(item.answer) }))
  .filter((item) => item.text)

const faqSchema =
  answered.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: answered.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.text },
        })),
      }
    : null
---

{
  items.length > 0 && (
    <div class="faqs">
      {items.map((item) => (
        <details class="faq" name={group}>
          <summary class="faq__q">
            <span class="faq__text">{item.question}</span>
            <span class="faq__mark" aria-hidden="true" />
          </summary>
          <div class="faq__a">
            <PortableText value={item.answer ?? []} />
          </div>
        </details>
      ))}
    </div>
  )
}

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
