---
/**
 * `callout` block from the Sanity article body: a quote set off by a thin line
 * on its left, as Wise marks a key rule. No fill. v2 renders these in
 * blue/amber/green; those hues are not in this site's palette (AGENTS.md
 * rule 4), so the tone is the line's colour: ember for a warning, grey for a
 * note or tip. A warning also says "Warning" in words, so the meaning never
 * rests on colour alone.
 */
import { PortableText } from 'astro-portabletext'
import type { PortableTextProps } from 'astro-portabletext/types'

interface Props {
  node: {
    type?: 'info' | 'warn' | 'success'
    body?: PortableTextProps['value']
  }
}

const { node } = Astro.props

// The schema defaults to 'info' and validates the field as required, but a
// document written through the API bypasses schema validation entirely — the
// Studio is the only thing that enforces it. So treat the field as optional.
const TONES = ['info', 'warn', 'success'] as const
const tone = TONES.find((t) => t === node.type) ?? 'info'
---

<blockquote class={`callout callout--${tone}`}>
  {tone === 'warn' && <strong class="callout__label">Warning</strong>}
  <PortableText value={node.body ?? []} />
</blockquote>
