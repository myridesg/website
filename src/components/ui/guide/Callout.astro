---
/**
 * `callout` block from the Sanity article body.
 *
 * v2 renders these in blue/amber/green (packages/ui/src/patterns/Callout.tsx).
 * Those hues do not exist in this site's palette and AGENTS.md rule 4 forbids
 * inventing brand values, so the three tones share the studio floor's grey
 * and differ by their label and the dot before it (reading.css).
 */
import { PortableText } from 'astro-portabletext'
import type { PortableTextProps } from 'astro-portabletext/types'

interface Props {
  node: {
    type?: 'info' | 'warn' | 'success'
    body?: PortableTextProps['value']
  }
}

const { node } = Astro.props

// The schema defaults to 'info' and validates the field as required, but a
// document written through the API bypasses schema validation entirely — the
// Studio is the only thing that enforces it. So treat the field as optional.
const LABELS = { info: 'Note', warn: 'Warning', success: 'Tip' } as const
const tone = node.type && node.type in LABELS ? node.type : 'info'
---

<aside class={`callout callout--${tone}`}>
  {/* A span, not a <p>: `.prose-body p` would add a paragraph's spacing to
      what is a one-word label. */}
  <span class="block-label">{LABELS[tone]}</span>

  <div>
    <PortableText value={node.body ?? []} />
  </div>
</aside>
