---
/**
 * `cta` block from the Sanity article body.
 *
 * v2 defaults a blank href to /auth/login. That route does not exist here and
 * never will — this site markets a native app and has no auth (AGENTS.md), so
 * inheriting that default would ship 29 links to a 404. Every CTA currently in
 * the dataset has href unset, so the blank case IS the common case: it renders
 * the site's real call to action instead, which points wherever the rest of the
 * site points and works with JavaScript off.
 *
 * An explicitly authored href is honoured as written.
 */
import StoreButtons from '@/components/ui/StoreButtons.astro'

interface Props {
  node: {
    label?: string
    href?: string | null
    note?: string | null
  }
}

const { node } = Astro.props

const href = node.href?.trim()
const label = node.label?.trim()
const note = node.note?.trim()

// Anything that leaves this origin gets the usual rel treatment.
const isExternal = Boolean(href && /^https?:\/\//i.test(href))
---

<aside class="my-9 rounded-md bg-soft px-6 py-7">
  {note && <p class="max-w-lg text-md leading-relaxed text-ink/75">{note}</p>}

  {
    href ? (
      <a
        href={href}
        rel={isExternal ? 'noreferrer' : undefined}
        class:list={[
          'mt-5 inline-flex min-h-12 items-center rounded-pill bg-ember px-7',
          // `!` beats ProseLayout's `.prose-body a`, which paints inline prose
          // links red and underlines them. That rule is right for a link inside
          // a sentence and wrong for a button.
          'text-md font-semibold text-on-dark! no-underline! transition-opacity hover:opacity-85',
        ]}
      >
        {label ?? 'Open MyRideSG'}
      </a>
    ) : (
      <StoreButtons class="mt-5" />
    )
  }
</aside>

<style>
  /* StoreButtons renders its own anchors, and ProseLayout's `.prose-body a`
     would paint them red and underlined — correct for a link inside a sentence,
     wrong for a download button. Scoped to this block, so prose links elsewhere
     in the article keep their styling. */
  aside :global(a) {
    color: inherit;
    text-decoration: none;
  }
</style>
