---
import type { GuideEntry } from '@/lib/guides'
import GuideGrid from './GuideGrid.astro'

/** "More guides": up to three cards under the article. */
interface Props {
  guides: GuideEntry[]
}

const { guides } = Astro.props
---

{
  guides.length > 0 && (
    <section class="guide-more">
      <h2 class="guide-more__title">More guides</h2>
      <GuideGrid guides={guides} />
    </section>
  )
}
