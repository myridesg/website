---
import { NAV } from '@/consts'
import type { NavItem } from '@/consts'

// "Get the app" used to open the web app, which is switched off. It now aims
// at the download block on the home page, and BaseLayout's platform script
// rewrites it straight to the reader's own store on a phone — so a tap on a
// phone installs, while a desktop click lands somewhere that shows both.
const GET_THE_APP = '/#get'
import ThemeToggle from './ThemeToggle.astro'

/**
 * The route being rendered, normalised the same way the anchor script below
 * normalises it (`/index.html` and `/` are the same route once built). Nav
 * entries compare against it for aria-current.
 */
const currentPath = Astro.url.pathname.replace(/index\.html$/, '')

/**
 * True when href is the page being rendered. /guides/ also stands for its
 * article pages — a reader on a guide is still in the Guides section.
 */
const isCurrent = (href: string) =>
  href === currentPath || (href === '/guides/' && currentPath.startsWith('/guides/'))

/** True when any child of a group is the current page; highlights the group. */
const groupIsCurrent = (item: NavItem) =>
  'children' in item && item.children.some((child) => isCurrent(child.href))

/**
 * The mobile panel renders NAV as labelled sections: an eyebrow, then its
 * links. Each link carries its row index as it is counted out, so the entry
 * stagger scales with the panel's real length instead of a hand-written
 * nth-child list that breaks the moment a group changes size.
 */
let row = 0
const MOBILE_SECTIONS = NAV.map((item) =>
  'children' in item
    ? {
        eyebrow: item.label,
        links: item.children.map((child) => ({ ...child, row: row++ })),
      }
    : {
        eyebrow: null,
        links: [{ label: item.label, href: item.href, row: row++ }],
      },
)
const CTA_ROW = row
---

<header class="fixed inset-x-0 top-4 z-50 px-4 md:top-6">
  <nav
    class="mx-auto flex max-w-4xl items-center justify-between gap-6 rounded-pill bg-paper/95 px-5 py-3 shadow-[0_4px_32px_rgba(8,8,8,0.18)] backdrop-blur-sm md:px-6"
    aria-label="Primary"
  >
    <a
      href="/"
      data-home-link
      class="font-display text-xl font-700 tracking-tight whitespace-nowrap"
    >
      MyRide<span class="text-red">SG</span>
    </a>

    <ul class="hidden items-center gap-5 md:flex lg:gap-7">
      {
        NAV.map((item) => (
          <li class="flex items-center">
            {'children' in item ? (
              <details class:list={['nav-drop', { 'nav-drop--current': groupIsCurrent(item) }]}>
                <summary class="nav-top">
                  {item.label}
                  <svg
                    class="nav-drop__chevron"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                </summary>

                <div class="nav-drop__panel">
                  <ul>
                    {item.children.map((child, i) => (
                      <li>
                        <a
                          href={child.href}
                          style={`--i: ${i}`}
                          aria-current={isCurrent(child.href) ? 'page' : undefined}
                        >
                          <span class="nav-drop__label">{child.label}</span>
                          <span class="nav-drop__desc">{child.description}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class="nav-top"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <ThemeToggle />

      <a
        href={GET_THE_APP}
        data-store-link
        class="hidden min-h-10 items-center rounded-pill bg-ink px-5 text-sm font-semibold text-paper transition-opacity hover:opacity-85 sm:inline-flex"
      >
        Get the app
      </a>

      <details class="site-menu md:hidden">
        <summary aria-label="Menu">
          <span class="site-menu__bars" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
        </summary>

        <div class="site-menu__panel">
          {
            MOBILE_SECTIONS.map((section) => (
              <>
                {section.eyebrow && (
                  <p class="site-menu__eyebrow eyebrow">{section.eyebrow}</p>
                )}
                <ul class:list={{ 'site-menu__plain': !section.eyebrow }}>
                  {section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        style={`--i: ${link.row}`}
                        aria-current={isCurrent(link.href) ? 'page' : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ))
          }

          <a
            href={GET_THE_APP}
            data-store-link
            class="site-menu__cta"
            style={`--i: ${CTA_ROW}`}
          >
            Get the app
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* ── Desktop top-level items ─────────────────────────────────────────────
     Links and dropdown summaries share one treatment so the four entries read
     as one row. 44px min height matches the toggle and the menu button: the
     pill is already that tall, so this buys touch targets without growing it. */
  .nav-top {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-block-size: 2.75rem;
    padding-inline: 0.25rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    color: --alpha(var(--color-ink) / 70%);
    transition: color 160ms ease;
    cursor: pointer;
  }

  .nav-top:hover {
    color: var(--color-ink);
  }

  summary.nav-top {
    list-style: none;
  }

  summary.nav-top::-webkit-details-marker {
    display: none;
  }

  /* The page being read, and — through .nav-drop--current — the group that
     contains it (Tools lights up on the COE calculator, for instance). */
  .nav-top[aria-current='page'],
  .nav-drop--current > summary.nav-top {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ── Desktop dropdown ────────────────────────────────────────────────────
     A bare <details>/<summary> pair: the open state is native semantics, so
     there is no aria-expanded to fake and no JS needed to open it. The small
     script below only adds dismissal. */
  .nav-drop {
    position: relative;
  }

  .nav-drop__chevron {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  .nav-drop[open] .nav-drop__chevron {
    transform: rotate(180deg);
  }

  .nav-drop__panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    inset-inline-start: 0;
    z-index: 20;
    inline-size: 19rem;
    padding: 0.5rem;
    border: 1px solid --alpha(var(--color-ink) / 8%);
    border-radius: 1.25rem;
    background: var(--color-paper);
    box-shadow: 0 18px 48px rgba(8, 8, 8, 0.22);
    transform-origin: top left;
  }

  .nav-drop__panel ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-drop__panel a {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: 0.75rem;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .nav-drop__panel a:hover,
  .nav-drop__panel a[aria-current='page'] {
    background: var(--color-soft);
  }

  .nav-drop__label {
    display: block;
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .nav-drop__panel a[aria-current='page'] .nav-drop__label {
    font-weight: 700;
  }

  /* Descriptions run at ink/70 rather than the muted token: on the soft hover
     fill, muted (#6f7178 on #f0f1f3) measures just under the 4.5:1 AA bar for
     12px text, and this stays above it in both themes. */
  .nav-drop__desc {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: --alpha(var(--color-ink) / 70%);
  }

  /* ── Mobile menu ───────────────────────────────────────────────────────── */

  .site-menu {
    position: relative;
  }

  /* Wider than the old 13rem: the labelled sections need the room, and this
     still clears a 360px viewport with the header's gutters to spare. */
  .site-menu__panel {
    inline-size: 17rem;
  }

  .site-menu__eyebrow {
    padding: 0.6rem 0.85rem 0.2rem;
    color: var(--color-muted);
  }

  .site-menu__panel > .site-menu__eyebrow:first-child {
    padding-top: 0.3rem;
  }

  /* ── Trigger ──────────────────────────────────────────────────────────── */

  .site-menu > summary {
    display: grid;
    place-items: center;
    inline-size: 2.75rem; /* 44px — full touch target */
    block-size: 2.75rem;
    border-radius: 9999px;
    cursor: pointer;
    list-style: none;
    transition: background-color 200ms ease;
  }

  .site-menu > summary::-webkit-details-marker {
    display: none;
  }

  .site-menu > summary:hover,
  .site-menu[open] > summary {
    background: --alpha(var(--color-ink) / 7%);
  }

  /* Three bars that fold into a cross. The outer pair translate to the centre
     and rotate; the middle one fades. Transform-only, so it stays on the
     compositor. */
  .site-menu__bars {
    position: relative;
    display: block;
    inline-size: 1.125rem;
    block-size: 0.75rem;
  }

  .site-menu__bars i {
    position: absolute;
    inset-inline: 0;
    block-size: 1.75px;
    border-radius: 2px;
    background: var(--color-ink);
    transition:
      transform 340ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 180ms ease;
  }

  .site-menu__bars i:nth-child(1) {
    top: 0;
  }
  .site-menu__bars i:nth-child(2) {
    top: 50%;
    translate: 0 -50%;
  }
  .site-menu__bars i:nth-child(3) {
    bottom: 0;
  }

  .site-menu[open] .site-menu__bars i:nth-child(1) {
    transform: translateY(0.365rem) rotate(45deg);
  }
  .site-menu[open] .site-menu__bars i:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }
  .site-menu[open] .site-menu__bars i:nth-child(3) {
    transform: translateY(-0.365rem) rotate(-45deg);
  }

  /* ── Panel ────────────────────────────────────────────────────────────── */

  .site-menu__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.6rem);
    padding: 0.5rem;
    border: 1px solid --alpha(var(--color-ink) / 8%);
    border-radius: 1.25rem;
    background: var(--color-paper);
    box-shadow: 0 18px 48px rgba(8, 8, 8, 0.22);
    transform-origin: top right;
  }

  .site-menu__panel ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Guides and Support render without an eyebrow, so left alone they read as
     the tail of the Tools group above them. A hairline — the panel's own
     border colour — above the first of them sets the plain links apart; the
     sibling rule keeps Guides and Support one block rather than two ruled
     sections. */
  .site-menu__panel ul.site-menu__plain {
    margin-top: 0.45rem;
    padding-top: 0.45rem;
    border-top: 1px solid --alpha(var(--color-ink) / 8%);
  }

  .site-menu__panel ul.site-menu__plain + ul.site-menu__plain {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .site-menu__panel a {
    display: block;
    /* 0.75rem block padding keeps every row at 45px — a full 44px touch
       target once line-height is included. */
    padding: 0.75rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: --alpha(var(--color-ink) / 78%);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .site-menu__panel a:hover,
  .site-menu__panel a[aria-current='page'] {
    background: var(--color-soft);
    color: var(--color-ink);
  }

  .site-menu__cta {
    margin-top: 0.35rem;
    text-align: center;
    background: var(--color-ink);
    color: var(--color-paper) !important;
    font-weight: 600 !important;
  }

  .site-menu__cta:hover {
    background: var(--color-ink) !important;
    opacity: 0.85;
  }

  /* Entry animation. A keyframe on [open] is more reliable here than
     transitioning ::details-content: a dropdown wants scale and lift, not a
     height reveal, and the panel is absolutely positioned so its height never
     affects layout. Each row is staggered slightly behind the panel so the
     menu assembles rather than appearing all at once. The delay is a custom
     property set per row in the markup, so it scales to however many rows a
     panel ends up with — capped, so the tail never trails the open gesture. */
  @media (prefers-reduced-motion: no-preference) {
    .site-menu[open] .site-menu__panel,
    .nav-drop[open] .nav-drop__panel {
      animation: menu-panel-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .site-menu[open] .site-menu__panel a,
    .nav-drop[open] .nav-drop__panel a {
      animation: menu-row-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: min(calc(40ms + var(--i, 0) * 30ms), 300ms);
    }
  }

  @keyframes menu-panel-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes menu-row-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // <details> has no notion of "click away to dismiss", which is the main thing
  // that makes a bare disclosure feel unfinished as a menu. This is that close
  // logic, generalised to every details menu on the page — the mobile
  // .site-menu and the desktop .nav-drop dropdowns alike. Without this script
  // the menus still open and close from their own summary, so the failure mode
  // is merely less convenient, not broken.
  const menus = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.site-menu, .nav-drop'),
  )

  menus.forEach((menu) => {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
    })

    // Opening one menu closes the others, so the header never shows two
    // panels at once. The toggle event fires for programmatic open/close too,
    // not just summary clicks.
    menu.addEventListener('toggle', () => {
      if (!menu.open) return
      menus.forEach((other) => {
        if (other !== menu && other.open) other.open = false
      })
    })

    // Navigating to an in-page anchor should dismiss it too.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false
      })
    })
  })
</script>

<script>
  /* `scroll-behavior: smooth` in global.css only ever animates a scroll WITHIN
   * a document that is already loaded. Two of this nav's links are not that:
   *
   *   /#features, /#faq  from any page other than the home page, these are full
   *                      cross-document navigations. The new document is simply
   *                      rendered already scrolled to the target, so the reader
   *                      is deposited mid-page with no sense of having moved.
   *   /                  from the home page itself this is a same-page reload,
   *                      which the browser services as a navigation — a cut, not
   *                      a scroll back to the top.
   *
   * Both are restored here. If this script never runs, every href is still a
   * plain link that lands in exactly the right place; only the movement between
   * is lost, which is the correct thing to degrade.
   */

  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

  /** `/index.html` and `/` are the same route once built. */
  const route = (path: string) => path.replace(/index\.html$/, '')

  /* ── Cross-page anchors ──────────────────────────────────────────────────
   *
   * Only a fresh navigation gets animated. A back or forward traversal must
   * land the reader exactly where they left — `history.scrollRestoration` is
   * deliberately left on its 'auto' default so the browser keeps doing that,
   * and replaying an animation over the top of a restore would both fight it
   * and misrepresent where they are. A reload is excluded for the same reason.
   */
  const navigation = performance.getEntriesByType('navigation')[0] as
    | PerformanceNavigationTiming
    | undefined

  // BaseLayout's inline head script detaches the fragment before the target is
  // ever parsed, and stashes it here — that is what guarantees the UA cannot
  // paint a frame at the destination first. It applies the same gates this block
  // does, so a stashed value is already known to be a fresh, non-reduced-motion
  // navigation. location.hash remains the fallback for the case where that
  // script did not run at all.
  const pending = (window as unknown as { __pendingHash?: string }).__pendingHash
  const hash = pending ?? location.hash
  const target =
    hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null

  if (target && navigation?.type === 'navigate' && !reduced()) {
    // Strip the fragment for the duration of the flight. The UA re-runs "scroll
    // to the fragment" as late layout shifts come in — a hero image landing,
    // a font swapping — and each of those would yank us to the destination
    // mid-animation. With no fragment in the document's URL there is nothing
    // for it to re-target. Already done by the head script in the normal path;
    // repeating it is harmless and covers the fallback.
    const bare = location.pathname + location.search
    history.replaceState(history.state, '', bare)

    // `scroll-behavior: smooth` applies to the legacy scrollTo(x, y) form too,
    // so this reset has to name `instant` explicitly. Left implicit it becomes
    // an animation of its own, running upwards into the one starting below.
    window.scrollTo({ top: 0, behavior: 'instant' })

    // Two frames. The first commits the reset, the second starts the animation
    // from a position the reader has actually been shown. Both in one frame
    // collapse into a single layout and the journey is invisible again — which
    // is the bug this whole block exists to fix.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        // scrollIntoView rather than a computed offset: the header is fixed, and
        // `:where([id]) { scroll-margin-top: 6rem }` in global.css already
        // accounts for it. Measuring the header here would duplicate that number
        // and then drift from it.
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })

        // Put the fragment back once we have arrived, so the URL is shareable
        // and a reload lands in the same place. replaceState, never
        // `location.hash =`: assigning the hash would jump the page and push a
        // junk entry into history, whereas replaceState does neither.
        const restore = () => history.replaceState(history.state, '', bare + hash)

        if ('onscrollend' in window) {
          window.addEventListener('scrollend', restore, { once: true })
        } else {
          // Safari has no scrollend, so a fixed delay is the only option there.
          // Being early is harmless — replaceState does not scroll, and by then
          // the document has loaded, so the UA is no longer fragment-seeking.
          setTimeout(restore, 1000)
        }
      })
    })
  }

  /* ── Brand link ──────────────────────────────────────────────────────────
   *
   * From another page it stays an ordinary navigation. From the home page,
   * scrolled down, the reader is asking to go back to the top of the page they
   * are already on, and a reload is a poor way to say that.
   */
  document.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      // Anything that is not a plain left click is the reader asking the browser
      // for something else — a new tab, a download, a saved link. Never take
      // those over.
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return
      }

      if (route(new URL(link.href).pathname) !== route(location.pathname)) return

      event.preventDefault()
      window.scrollTo({ top: 0, behavior: reduced() ? 'instant' : 'smooth' })

      // A lingering #faq would otherwise send the next reload straight back down
      // the page the reader just asked to leave.
      if (location.hash) {
        history.replaceState(history.state, '', location.pathname + location.search)
      }
    })
  })
</script>
