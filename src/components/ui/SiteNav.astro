---
import { Image } from 'astro:assets'
import Chevron from './Chevron.astro'
import { NAV } from '@/consts'
import type { NavItem } from '@/consts'
import ThemeToggle from './ThemeToggle.astro'
import appIcon from '@/assets/home/app-icon.png'

// "Get the app" used to open the web app, which is switched off. It now aims
// at the download block on the home page, and BaseLayout's platform script
// rewrites it straight to the reader's own store on a phone — so a tap on a
// phone installs, while a desktop click lands somewhere that shows both.
const GET_THE_APP = '/#download'

/**
 * The route being rendered, normalised the same way the anchor script below
 * normalises it (`/index.html` and `/` are the same route once built). Nav
 * entries compare against it for aria-current.
 */
const currentPath = Astro.url.pathname.replace(/index\.html$/, '')

/**
 * True when href is the page being rendered. /guides/ also stands for its
 * article pages — a reader on a guide is still in the Guides section.
 */
const isCurrent = (href: string) =>
  href === currentPath || (href === '/guides/' && currentPath.startsWith('/guides/'))

/** True when any child of a group is the current page; highlights the group. */
const groupIsCurrent = (item: NavItem) =>
  'children' in item && item.children.some((child) => isCurrent(child.href))

/**
 * The mobile panel lists NAV as rows. A group (Features) is a row that opens
 * in place, closed unless the reader is on one of its pages. Each row carries
 * its index for the entry stagger: top rows count across the panel, a group's
 * links count from zero again, because they enter when the group opens.
 */
---

<header class="site-header" data-site-header data-analytics-location="header">
  <nav class="site-header__bar" aria-label="Primary">
    <a href="/" data-home-link class="site-header__brand">
      <Image
        src={appIcon}
        alt=""
        width={96}
        height={96}
        loading="eager"
        class="site-header__icon"
      />
      MyRide<span class="site-header__sg">SG</span>
    </a>

    <ul class="site-header__links">
      {
        NAV.map((item) => (
          <li>
            {'children' in item ? (
              <details class:list={['nav-drop', { 'nav-drop--current': groupIsCurrent(item) }]}>
                <summary class="nav-top">
                  {item.label}
                  <Chevron class="nav-drop__chevron" />
                </summary>

                <div class="nav-drop__panel">
                  <ul>
                    {item.children.map((child, i) => (
                      <li>
                        <a
                          href={child.href}
                          style={`--i: ${i}`}
                          aria-current={isCurrent(child.href) ? 'page' : undefined}
                        >
                          <span class="nav-drop__label">{child.label}</span>
                          <span class="nav-drop__desc">{child.description}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class="nav-top"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <div class="site-header__actions">
      <ThemeToggle />

      <a href={GET_THE_APP} data-store-link class="site-header__cta">Get the app</a>

      <details class="site-menu">
        <summary aria-label="Menu">
          <span class="site-menu__bars" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
        </summary>

        <div class="site-menu__panel">
          <ul>
            {
              NAV.map((item, row) => (
                <li>
                  {'children' in item ? (
                    <details class="site-menu__group" open={groupIsCurrent(item)}>
                      <summary class="site-menu__row" style={`--i: ${row}`}>
                        {item.label}
                        <Chevron class="site-menu__chevron" />
                      </summary>
                      <ul class="site-menu__children">
                        {item.children.map((child, i) => (
                          <li>
                            <a
                              href={child.href}
                              style={`--i: ${i}`}
                              aria-current={isCurrent(child.href) ? 'page' : undefined}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a
                      class="site-menu__row"
                      href={item.href}
                      style={`--i: ${row}`}
                      aria-current={isCurrent(item.href) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* ── The bar ─────────────────────────────────────────────────────────────
     Two states, one element.

       At rest      flat on the page: no ground of its own, no shadow, its
                    content on the page's own side gutters.
       Scrolled     pinned to the top edge, full width, slim, on the page
                    colour with a hairline under it.

     It is position:absolute by default, so with JavaScript off it is simply
     the top of the page and scrolls away with it — never a transparent strip
     left over moving content. BaseLayout's head script sets data-js before
     first paint; only then is it fixed, and the script at the foot of this
     file sets data-scrolled once the page has moved. Either way it is out of
     flow, so changing state never moves the page: each page clears
     --site-bar (global.css) at its top, and anchor jumps clear the slim bar
     through scroll-padding-top.

     Pages line the wordmark up with their own content by setting
     --site-header-max and --site-header-gutter (home.css does); the
     fallbacks are the .shell utility's. */
  .site-header {
    --bar-h: var(--site-bar);
    --bar-ink: var(--color-ink);
    --bar-label: --alpha(var(--color-ink) / 80%);
    --bar-sg: var(--color-red);
    /* Red has one job on the site: the main action. */
    --bar-cta-bg: var(--color-red);
    --bar-cta-ink: var(--color-on-dark);
    /* The app icon is black: a hairline lets it read on a near-black bar. */
    --bar-icon-ring: light-dark(transparent, rgb(255 255 255 / 0.2));
    --bar-hover: --alpha(var(--color-ink) / 7%);
    /* The ground at rest (none) and once pinned. A page tone (guides.css)
       sets these tokens; nothing outside this file restyles the bar. */
    --bar-bg: transparent;
    --bar-bg-pinned: var(--color-paper);
    --gutter: var(--site-header-gutter, 1.25rem);

    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    color: var(--bar-ink);
    background: var(--bar-bg);
  }

  @media (width >= 48rem) {
    .site-header {
      --gutter: var(--site-header-gutter, 2rem);
    }
  }

  :global(:root[data-js]) .site-header {
    position: fixed;
  }

  .site-header[data-scrolled],
  .site-header:has(.site-menu[open]) {
    --bar-h: var(--site-bar-slim);
    /* A shadow, not a border: the hairline adds nothing to the bar's height. */
    box-shadow: 0 1px 0 --alpha(var(--color-ink) / 10%);
    background: var(--bar-bg-pinned);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    block-size: var(--bar-h);
    max-inline-size: var(--site-header-max, 80rem);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        background-color 220ms ease,
        box-shadow 220ms ease;
    }

    .site-header__bar {
      transition: block-size 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .site-header__brand {
      transition: scale 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  /* ── Wordmark ── */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    margin-inline-end: auto;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.005em;
    white-space: nowrap;
    color: var(--bar-ink);
    transform-origin: left center;
  }

  @media (width >= 48rem) {
    .site-header[data-scrolled] .site-header__brand {
      scale: 0.8;
    }
  }

  /* The full-size wordmark waits for the room: between 768px and 1024px the
     four nav labels sit close, and the icon takes the space it would use. */
  @media (width >= 64rem) {
    .site-header__brand {
      font-size: 1.875rem;
    }
  }

  .site-header__sg {
    color: var(--bar-sg);
  }

  /* The app icon, as it sits on a phone's home screen: a rounded square at
     an app icon's corner (22% of its size). It stands before the wordmark
     inside the same link, so the pair scales together when the bar slims. */
  .site-header__icon {
    flex: none;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    margin-inline-end: 0.5rem;
    border-radius: 22%;
    box-shadow: 0 0 0 1px var(--bar-icon-ring);
  }

  /* Below 360px the bar holds the wordmark, the theme toggle, "Get the app"
     and the menu button with nothing to spare; the icon goes rather than
     squeeze the controls. */
  @media (width < 22.5rem) {
    .site-header__icon {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .site-header__icon {
      inline-size: 2rem;
      block-size: 2rem;
      margin-inline-end: 0.625rem;
    }
  }

  /* ── Top-level items (768px and up) ──────────────────────────────────────
     Quiet spaced caps, the same voice as the page's small labels. Links and
     dropdown summaries share one treatment so the four read as one row. A
     rule under the item marks the page being read, and — through
     .nav-drop--current — the group that holds it. */
  .site-header__links {
    display: none;
    align-items: center;
    gap: clamp(0.75rem, 2.2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .site-header__links {
      display: flex;
    }
  }

  .nav-top {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-block-size: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bar-label);
    cursor: pointer;
    transition: color 160ms ease;
  }

  .nav-top::after {
    content: '';
    position: absolute;
    inset-inline: 0 0.12em;
    bottom: 0.55rem;
    block-size: 2px;
    background: currentColor;
    scale: 0 1;
    transform-origin: left center;
    transition: scale 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-top:hover,
  .nav-top[aria-current='page'],
  .nav-drop--current > .nav-top,
  .nav-drop[open] > .nav-top {
    color: var(--bar-ink);
  }

  .nav-top:hover::after,
  .nav-top[aria-current='page']::after,
  .nav-drop--current > .nav-top::after {
    scale: 1 1;
  }

  summary.nav-top {
    list-style: none;
  }

  summary.nav-top::-webkit-details-marker {
    display: none;
  }

  /* ── Desktop dropdown ────────────────────────────────────────────────────
     A bare <details>/<summary> pair: the open state is native semantics, so
     there is no aria-expanded to fake and no JS needed to open it. The script
     below only adds dismissal. */
  .nav-drop {
    position: relative;
  }

  .nav-drop__chevron {
    inline-size: 0.8rem;
    block-size: 0.8rem;
    flex-shrink: 0;
    transition: rotate 200ms ease;
  }

  .nav-drop[open] .nav-drop__chevron {
    rotate: 180deg;
  }

  .nav-drop__panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    inset-inline-start: -0.75rem;
    z-index: 20;
    inline-size: 20rem;
    padding: 0.375rem;
    border-radius: 0.75rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow:
      0 0 0 1px --alpha(var(--color-ink) / 9%),
      0 24px 48px -16px rgb(8 8 8 / 0.3);
    transform-origin: top left;
  }

  .nav-drop__panel ul,
  .site-menu__panel ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-drop__panel a {
    display: block;
    padding: 0.7rem 0.75rem;
    border-radius: 0.5rem;
    transition: background-color 160ms ease;
  }

  .nav-drop__panel a:hover,
  .nav-drop__panel a[aria-current='page'] {
    background: var(--color-soft);
  }

  .nav-drop__label {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  /* ink/70 rather than the muted token: on the soft hover fill, muted
     measures just under 4.5:1 for 12px text; this stays above it in both
     themes. */
  .nav-drop__desc {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: --alpha(var(--color-ink) / 70%);
  }

  /* ── Actions: theme, Get the app, menu ── */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (width >= 48rem) {
    .site-header__actions {
      gap: 0.5rem;
      margin-inline-start: clamp(0.5rem, 1.5vw, 1.5rem);
    }
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    margin-inline-start: 0.25rem;
    padding-inline: 0.75rem;
    border-radius: 0.5rem;
    background: var(--bar-cta-bg);
    color: var(--bar-cta-ink);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 160ms ease;
  }

  .site-header__cta:hover {
    opacity: 0.86;
  }

  @media (width >= 48rem) {
    .site-header__cta {
      padding-inline: 1.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.1em;
    }
  }

  /* ── Phone menu (under 768px) ─────────────────────────────────────────── */
  @media (width >= 48rem) {
    .site-menu {
      display: none;
    }
  }

  .site-menu > summary {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-end: -0.625rem; /* the bars, not the target, meet the gutter */
    border-radius: 0.5rem;
    cursor: pointer;
    list-style: none;
    transition: background-color 200ms ease;
  }

  .site-menu > summary::-webkit-details-marker {
    display: none;
  }

  .site-menu > summary:hover {
    background: var(--bar-hover);
  }

  /* Three bars that fold into a cross. Transform-only. */
  .site-menu__bars {
    position: relative;
    display: block;
    inline-size: 1.25rem;
    block-size: 0.75rem;
  }

  .site-menu__bars i {
    position: absolute;
    inset-inline: 0;
    block-size: 2px;
    background: var(--bar-ink);
    transition:
      transform 340ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 180ms ease;
  }

  .site-menu__bars i:nth-child(1) {
    top: 0;
  }
  .site-menu__bars i:nth-child(2) {
    top: 50%;
    translate: 0 -50%;
  }
  .site-menu__bars i:nth-child(3) {
    bottom: 0;
  }

  .site-menu[open] .site-menu__bars i:nth-child(1) {
    transform: translateY(0.3125rem) rotate(45deg);
  }
  .site-menu[open] .site-menu__bars i:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }
  .site-menu[open] .site-menu__bars i:nth-child(3) {
    transform: translateY(-0.3125rem) rotate(-45deg);
  }

  /* The panel hangs from the whole bar, edge to edge: .site-menu is not
     positioned, so the header is its containing block. */
  .site-menu__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-block-size: calc(100dvh - var(--bar-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem var(--gutter) 1.75rem;
    border-block: 1px solid --alpha(var(--color-ink) / 10%);
    background: var(--color-paper);
    /* Dims the page below the panel, so the panel reads as on top of it in
       both themes (in dark the two grounds are the same colour). The clip
       keeps the dimming off the bar above. */
    box-shadow: 0 0 0 100vmax rgb(8 8 8 / 0.4);
    clip-path: inset(0 0 -100vmax 0);
  }

  .site-menu__panel > ul,
  .site-menu__children {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A hairline between the top rows. */
  .site-menu__panel > ul > li + li {
    border-top: 1px solid --alpha(var(--color-ink) / 10%);
  }

  .site-menu__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-block-size: 3.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  .site-menu__row::-webkit-details-marker {
    display: none;
  }

  .site-menu__chevron {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    transition: rotate 200ms ease;
  }

  .site-menu__group[open] .site-menu__chevron {
    rotate: 180deg;
  }

  /* A group's links sit under its row, smaller and indented, on a rule that
     ties them to it. */
  .site-menu__children {
    /* after the reset above, so these win */
    margin-block-end: 0.75rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid --alpha(var(--color-ink) / 12%);
  }

  .site-menu__children a {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .site-menu__row:hover,
  .site-menu__children a:hover {
    color: --alpha(var(--color-ink) / 72%);
  }

  .site-menu__row[aria-current='page'],
  .site-menu__children a[aria-current='page'] {
    /* Red on the light panel (4.85:1); the foreground on the dark one, where
       red text would not pass. */
    color: light-dark(var(--color-red), var(--color-ink));
  }

  /* Entry: the panel drops a short way and each row follows a beat behind,
     staggered by its --i and capped so the tail never trails the gesture. */
  @media (prefers-reduced-motion: no-preference) {
    .site-menu[open] .site-menu__panel,
    .nav-drop[open] .nav-drop__panel {
      animation: menu-panel-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .site-menu[open] .site-menu__row,
    .site-menu__group[open] .site-menu__children a,
    .nav-drop[open] .nav-drop__panel a {
      animation: menu-row-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: min(calc(40ms + var(--i, 0) * 30ms), 300ms);
    }
  }

  @keyframes menu-panel-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes menu-row-in {
    from {
      opacity: 0.35;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // The scrolled state. Without this script the header never pins (it is not
  // fixed until data-js is set), so there is nothing to keep in step.
  const header = document.querySelector<HTMLElement>('[data-site-header]')!
  const syncScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 8)

  syncScrolled()
  window.addEventListener('scroll', syncScrolled, { passive: true })
</script>

<script>
  // <details> has no notion of "click away to dismiss", which is the main thing
  // that makes a bare disclosure feel unfinished as a menu. This is that close
  // logic, generalised to every details menu on the page — the mobile
  // .site-menu and the desktop .nav-drop dropdowns alike. Without this script
  // the menus still open and close from their own summary, so the failure mode
  // is merely less convenient, not broken.
  const menus = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.site-menu, .nav-drop'),
  )

  menus.forEach((menu) => {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
    })

    // Opening one menu closes the others, so the header never shows two
    // panels at once. The toggle event fires for programmatic open/close too,
    // not just summary clicks.
    menu.addEventListener('toggle', () => {
      if (!menu.open) return
      menus.forEach((other) => {
        if (other !== menu && other.open) other.open = false
      })
    })

    // Navigating to an in-page anchor should dismiss it too.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false
      })
    })
  })
</script>

<script>
  /* `scroll-behavior: smooth` in global.css only ever animates a scroll WITHIN
   * a document that is already loaded. Two of this nav's links are not that:
   *
   *   /#download         from any page other than the home page, this is a full
   *                      cross-document navigation. The new document is simply
   *                      rendered already scrolled to the target, so the reader
   *                      is deposited mid-page with no sense of having moved.
   *   /                  from the home page itself this is a same-page reload,
   *                      which the browser services as a navigation — a cut, not
   *                      a scroll back to the top.
   *
   * Both are restored here. If this script never runs, every href is still a
   * plain link that lands in exactly the right place; only the movement between
   * is lost, which is the correct thing to degrade.
   */

  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

  /** `/index.html` and `/` are the same route once built. */
  const route = (path: string) => path.replace(/index\.html$/, '')

  /* ── Cross-page anchors ──────────────────────────────────────────────────
   *
   * Only a fresh navigation gets animated. A back or forward traversal must
   * land the reader exactly where they left — `history.scrollRestoration` is
   * deliberately left on its 'auto' default so the browser keeps doing that,
   * and replaying an animation over the top of a restore would both fight it
   * and misrepresent where they are. A reload is excluded for the same reason.
   */
  const navigation = performance.getEntriesByType('navigation')[0] as
    | PerformanceNavigationTiming
    | undefined

  // BaseLayout's inline head script detaches the fragment before the target is
  // ever parsed, and stashes it here — that is what guarantees the UA cannot
  // paint a frame at the destination first. It applies the same gates this block
  // does, so a stashed value is already known to be a fresh, non-reduced-motion
  // navigation. location.hash remains the fallback for the case where that
  // script did not run at all.
  const pending = (window as unknown as { __pendingHash?: string }).__pendingHash
  const hash = pending ?? location.hash
  const target =
    hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null

  if (target && navigation?.type === 'navigate' && !reduced()) {
    // Strip the fragment for the duration of the flight. The UA re-runs "scroll
    // to the fragment" as late layout shifts come in — a hero image landing,
    // a font swapping — and each of those would yank us to the destination
    // mid-animation. With no fragment in the document's URL there is nothing
    // for it to re-target. Already done by the head script in the normal path;
    // repeating it is harmless and covers the fallback.
    const bare = location.pathname + location.search
    history.replaceState(history.state, '', bare)

    // `scroll-behavior: smooth` applies to the legacy scrollTo(x, y) form too,
    // so this reset has to name `instant` explicitly. Left implicit it becomes
    // an animation of its own, running upwards into the one starting below.
    window.scrollTo({ top: 0, behavior: 'instant' })

    // Two frames. The first commits the reset, the second starts the animation
    // from a position the reader has actually been shown. Both in one frame
    // collapse into a single layout and the journey is invisible again — which
    // is the bug this whole block exists to fix.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        // scrollIntoView rather than a computed offset: the header is fixed, and
        // `scroll-padding-top: var(--site-bar-slim)` in global.css already
        // accounts for it. Measuring the header here would duplicate that number
        // and then drift from it.
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })

        // Put the fragment back once we have arrived, so the URL is shareable
        // and a reload lands in the same place. replaceState, never
        // `location.hash =`: assigning the hash would jump the page and push a
        // junk entry into history, whereas replaceState does neither.
        const restore = () => history.replaceState(history.state, '', bare + hash)

        if ('onscrollend' in window) {
          window.addEventListener('scrollend', restore, { once: true })
        } else {
          // Safari has no scrollend, so a fixed delay is the only option there.
          // Being early is harmless — replaceState does not scroll, and by then
          // the document has loaded, so the UA is no longer fragment-seeking.
          setTimeout(restore, 1000)
        }
      })
    })
  }

  /* ── Brand link ──────────────────────────────────────────────────────────
   *
   * From another page it stays an ordinary navigation. From the home page,
   * scrolled down, the reader is asking to go back to the top of the page they
   * are already on, and a reload is a poor way to say that.
   */
  document.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      // Anything that is not a plain left click is the reader asking the browser
      // for something else — a new tab, a download, a saved link. Never take
      // those over.
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return
      }

      if (route(new URL(link.href).pathname) !== route(location.pathname)) return

      event.preventDefault()
      window.scrollTo({ top: 0, behavior: reduced() ? 'instant' : 'smooth' })

      // A lingering #detail would otherwise send the next reload straight back down
      // the page the reader just asked to leave.
      if (location.hash) {
        history.replaceState(history.state, '', location.pathname + location.search)
      }
    })
  })
</script>
