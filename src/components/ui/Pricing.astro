---
import StoreButtons from "./StoreButtons.astro";

// Deliberately does NOT promise permanence. "Free forever" is forbidden by the
// Claim Guardrails, and paid tiers are on the roadmap, so the copy names what
// is free today and signals that more advanced tools may be paid — without
// framing the product as a paywalled app.
---

<section id="pricing" class="bg-paper py-20 md:py-28">
    <div class="shell">
        <div
            class="mx-auto max-w-xl rounded-3xl border-2 border-red px-8 py-12 text-center md:px-12 md:py-14"
        >
            <p class="eyebrow text-red">Pricing</p>

            <h2 class="mt-4 text-display md:text-display-lg">
                Free where it counts.
            </h2>

            <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-muted">
                Keeping track of your bike costs nothing. Servicing history,
                renewal dates, fuel logs and running costs are all free to
                use. That is the part every rider needs, and the part we lead
                with.
            </p>

            <!-- <p class="mx-auto mt-4 max-w-md text-md leading-relaxed text-muted">
        We're building deeper tools on top of that. Some of those will sit on a
        paid plan for riders who want them.
      </p> -->

            <StoreButtons center class="mt-8" />

            <p class="mt-6 text-sm text-muted">No card required to start.</p>
        </div>
    </div>
</section>
