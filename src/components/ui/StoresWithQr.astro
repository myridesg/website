---
import { encode, QrCodeDataType } from 'uqr'

/**
 * The finale's store badges (passed in the slot) with, on a desktop, a QR
 * code beside them for the phone in the reader's pocket. It opens /get/,
 * which sends an iPhone to the App Store and an Android phone to Google Play.
 *
 * Encoded here at build time; the page gets plain SVG and no script. The
 * three finder squares are drawn as rounded squares and the data modules
 * with a slight rounding, which scanners read as they do square modules.
 * ECC level M survives that and a little glare off a screen.
 *
 * Shown only where a QR makes sense: a wide screen with a mouse. On a phone
 * the badges already go straight to the store.
 */
interface Props {
  class?: string
}

const { class: className } = Astro.props

const target = new URL('/get/', Astro.site).href
const qr = encode(target, { ecc: 'M', border: 0 })

const isFinder = (x: number, y: number) =>
  qr.types[y][x] === QrCodeDataType.Position
const modules: [number, number][] = []
for (let y = 0; y < qr.size; y++) {
  for (let x = 0; x < qr.size; x++) {
    if (qr.data[y][x] && !isFinder(x, y)) modules.push([x, y])
  }
}
const finders = [
  [0, 0],
  [qr.size - 7, 0],
  [0, qr.size - 7],
] as const
---

<div class:list={['stores-qr', className]}>
  <slot />

  <figure class="stores-qr__code">
    <span class="stores-qr__tile">
      <svg viewBox={`0 0 ${qr.size} ${qr.size}`} role="img" aria-label={`QR code for ${target}`}>
        {modules.map(([x, y]) => <rect x={x + 0.04} y={y + 0.04} width="0.92" height="0.92" rx="0.25" />)}
        {
          finders.map(([x, y]) => (
            <>
              <rect x={x + 0.5} y={y + 0.5} width="6" height="6" rx="1.6" class="stores-qr__ring" />
              <rect x={x + 2} y={y + 2} width="3" height="3" rx="0.8" />
            </>
          ))
        }
      </svg>
    </span>
    <figcaption class="stores-qr__label">Scan to get the app</figcaption>
  </figure>
</div>

<style>
  .stores-qr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2rem;
  }

  .stores-qr__code {
    display: none;
  }

  /* A desktop: wide, with a mouse. A tablet or a phone held sideways keeps
     the badges alone. */
  @media (width >= 64rem) and (hover: hover) and (pointer: fine) {
    .stores-qr__code {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 0;
      padding-inline-start: 2rem;
      border-inline-start: 1px solid rgb(255 255 255 / 0.16);
      text-align: start;
    }
  }

  /* Ink on white, with the quiet zone a scanner needs inside the tile. */
  .stores-qr__tile {
    display: block;
    inline-size: 5.5rem;
    padding: 0.5rem;
    border-radius: 0.875rem;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.3);
  }

  .stores-qr__tile svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    fill: var(--color-black);
  }

  .stores-qr__ring {
    fill: none;
    stroke: var(--color-black);
    stroke-width: 1;
  }

  .stores-qr__label {
    max-inline-size: 6.5rem;
    font-size: var(--text-2xs);
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ask-sub, rgb(255 255 255 / 0.6));
  }
</style>
