---
// Numbered because these genuinely are sequential — you cannot log against a
// bike you have not added. The numerals carry order, not decoration.
const STEPS = [
  {
    n: '01',
    title: 'Add your bike',
    body: 'Enter the plate, model and renewal dates. Setup takes about two minutes.',
  },
  {
    n: '02',
    title: 'Log as you ride',
    body: 'Add fill-ups, servicing and expenses from any screen in a few taps.',
  },
  {
    n: '03',
    title: 'Review your next due dates',
    body: 'Keep your servicing interval, road tax, COE and insurance dates together.',
  },
]
---

<section id="how-it-works" class="bg-soft py-20 md:py-28">
  <div class="shell">
    <p class="eyebrow text-red">How it works</p>

    <h2 class="mt-4 text-display-sm md:text-display">Three steps to get started.</h2>

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        STEPS.map((step) => (
          <li class="rounded-xl bg-paper p-7 md:p-8">
            <p class="font-display text-display-sm leading-none font-700 text-red">{step.n}</p>
            <h3 class="mt-4 text-2xl">{step.title}</h3>
            <p class="mt-2 text-md leading-relaxed text-ink/75">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
