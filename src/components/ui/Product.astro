---
import PhoneFrame from './PhoneFrame.astro'
import BikeScreen from './app/BikeScreen.astro'
import FuelScreen from './app/FuelScreen.astro'
import WorkshopsScreen from './app/WorkshopsScreen.astro'

// These were flat WebP captures of the app. They are now the app's screens
// rebuilt as HTML in src/components/ui/app/, ported from the React Native
// source in myridesg-v2/apps/mobile with its own tokens (see the .app-screen
// block in global.css). Three reasons:
//
//   1. A screenshot is a bitmap. It went soft on a retina display and it could
//      not respond to anything.
//   2. It could not follow the theme. The captures were light-mode only, so a
//      reader in dark mode got three bright rectangles.
//   3. A capture drifts silently. Text here is real text — it is searchable,
//      it scales with the reader's font size, and a stale string is a diff.
//
// The screens are inert: no JS, no interactivity, no claim that they are.
const ROWS = [
  {
    title: 'Ownership at a glance',
    body: 'Road tax, COE and insurance countdowns on a single screen, so nothing needs looking up and nothing gets missed.',
    href: '/motorcycle-maintenance-app/',
    linkLabel: 'Explore the maintenance app',
    Screen: BikeScreen,
    label: 'MyRideSG bike overview: road tax due in 21 days, alongside the other key ownership dates',
    frame: 'bg-rose',
  },
  {
    title: 'Every dollar you spend riding',
    body: 'Log fill-ups in seconds. Track cost per kilometre, monthly spend and efficiency over time, so you know what the bike really costs.',
    href: '/motorcycle-expense-tracker/',
    linkLabel: 'See the expense tracker',
    Screen: FuelScreen,
    label: 'MyRideSG fuel screen: log a fill-up, the cheapest RON95 nearby, and fuel economy in km per litre',
    frame: 'bg-soft',
  },
  {
    title: 'Find a workshop in two taps',
    body: 'Browse workshops near you, review the services they offer, and get in touch without leaving the app.',
    href: '/motorcycle-workshop-directory/',
    linkLabel: 'Browse the workshop directory',
    Screen: WorkshopsScreen,
    label: 'MyRideSG workshops directory with call, WhatsApp, directions and website actions',
    frame: 'bg-rose',
  },
]
---

<section id="features" class="bg-paper pb-20 md:pb-28">
  <div class="shell">
    <p class="eyebrow text-red">The app</p>

    <h2 class="mt-4 max-w-xl text-display-sm md:text-display">
      Your motorcycle app for maintenance, fuel and costs.
    </h2>

    <div class="mt-14 flex flex-col gap-16 md:gap-24">
      {
        ROWS.map((row, i) => (
          <div class="grid items-center gap-8 md:grid-cols-2 md:gap-16">
            <div class:list={[i % 2 === 1 && 'md:order-2']}>
              <h3 class="text-display-sm md:text-[2.5rem]">{row.title}</h3>
              <p class="mt-4 max-w-md text-lg leading-relaxed text-muted">{row.body}</p>
              <a
                href={row.href}
                class="mt-4 inline-block text-md font-semibold text-red hover:underline"
              >
                {row.linkLabel} →
              </a>
            </div>

            <div
              class:list={[
                'flex justify-center rounded-3xl px-6 py-10 md:px-12 md:py-14',
                row.frame,
                i % 2 === 1 && 'md:order-1',
              ]}
            >
              {/* chrome={false} — each screen draws its own status bar, so it
                  can set the tone its own top band needs. See AppStatusBar.

                  Padding is symmetric and the frame carries no negative margin,
                  so the whole device sits inside the panel. This is deliberately
                  unlike the v2 marketing page, where the phone bleeds off the
                  bottom edge: the panel is taller as a result, but the device
                  reads as a complete object rather than a cropped one.

                  role="img" + aria-label: a screen reader should hear "the app
                  looks like this", not walk forty spans of sample data. */}
              <figure class="mx-auto">
                <PhoneFrame variant="light" width={270} chrome={false}>
                  <div class="app-screen" role="img" aria-label={row.label}>
                    <row.Screen />
                  </div>
                </PhoneFrame>
                <figcaption class="mt-5 max-w-xs text-center text-sm leading-relaxed text-ink/75">
                  Illustrative app preview with sample data.
                </figcaption>
              </figure>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
