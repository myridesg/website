---
import StoreButtons from './StoreButtons.astro'

// Copy deliberately stops at browsing and contact. The creative brief forbids
// promising in-app booking or quote flows until production verification
// confirms them, so "Request quotes / Book a slot" from the original draft
// is not used here.
---

<section id="workshops" class="bg-black py-20 md:py-28">
  <div class="shell">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-end md:gap-14">
      <div>
        <p class="eyebrow text-ember-on-dark">Workshops</p>

        <h2 class="mt-4 max-w-2xl text-display-sm text-on-dark md:text-display-lg">
          Find motorcycle workshops in Singapore before you need one.
        </h2>

        <p class="mt-5 max-w-lg text-lg leading-relaxed text-white/65">
          Browse Singapore motorcycle workshops by region and speciality, review
          the services they offer, and find their contact details in the app.
        </p>

        <a
          href="/motorcycle-workshop-directory/"
          class="mt-4 inline-block text-md font-semibold text-ember-on-dark hover:underline"
        >
          Explore the workshop directory →
        </a>

        <StoreButtons tone="light" class="mt-8" />
      </div>

      <aside class="max-w-xs rounded-xl border border-white/18 bg-white/5 p-7">
        <p class="eyebrow text-white/55">For workshop owners</p>
        <p class="mt-3 text-lg leading-snug font-semibold text-on-dark">
          Own a workshop? Get listed where Singapore riders are already
          searching.
        </p>
        <a
          href="mailto:hello@myridesg.com"
          class="mt-3 inline-block text-md font-semibold text-ember-on-dark hover:underline"
        >
          Enquire about a listing
        </a>
      </aside>
    </div>
  </div>
</section>
