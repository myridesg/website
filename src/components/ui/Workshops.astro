---
// Copy deliberately stops at browsing and contact. The creative brief forbids
// promising in-app booking or quote flows until production verification
// confirms them, so "Request quotes / Book a slot" from the original draft
// is not used here.
---

<section id="workshops" class="bg-black py-20 md:py-28">
  <div class="shell">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-end md:gap-14">
      <div>
        <p class="eyebrow text-ember-on-dark">Workshops</p>

        <h2 class="mt-4 max-w-2xl text-display-sm text-paper md:text-display-lg">
          Compare workshops before you need one.
        </h2>

        <p class="mt-5 max-w-lg text-lg leading-relaxed text-white/65">
          Browse Singapore bike workshops by region and speciality, see the
          services they offer, and get their contact details in the app.
        </p>

        <a
          href="/demo"
          class="mt-8 inline-flex min-h-12 items-center rounded-pill bg-ember px-7 text-md font-semibold text-paper transition-opacity hover:opacity-85"
        >
          See it in the demo
        </a>
      </div>

      <aside class="max-w-xs rounded-xl border border-white/18 bg-white/5 p-7">
        <p class="eyebrow text-white/40">For workshop owners</p>
        <p class="mt-3 text-lg leading-snug font-semibold text-paper">
          Run a workshop? Get listed where riders are already looking.
        </p>
        <a
          href="mailto:hello@myridesg.com"
          class="mt-3 inline-block text-md font-semibold text-ember-on-dark hover:underline"
        >
          Get in touch →
        </a>
      </aside>
    </div>
  </div>
</section>
