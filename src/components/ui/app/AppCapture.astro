---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

/**
 * A real screen of the app, captured in the iOS Simulator, for use inside
 * PhoneFrame. Takes the light and the dark capture of the same screen and shows
 * whichever matches the site's theme, so the phone follows the toggle the way
 * the HTML-rendered HomeScreen does.
 *
 * Captures are 1206x2622 (iPhone 16 Pro), the same 549:1194 ratio as the
 * PhoneFrame screen, so they fill it without cropping.
 *
 * The light capture loads eagerly; the dark one is lazy, and a lazy image that
 * is display:none is never fetched, so a light-theme visit downloads one image.
 */
interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  /** What the screen shows — the captures are the whole content, so say it in words. */
  alt: string
}

const { light, dark, alt } = Astro.props
const imageProps = { widths: [300, 450, 600, 900], sizes: '300px' }
---

<div class="app-capture">
  <Image src={light} alt={alt} class="app-capture__light" loading="eager" {...imageProps} />
  <Image src={dark} alt={alt} class="app-capture__dark" loading="lazy" {...imageProps} />
</div>

<style>
  .app-capture {
    block-size: 100%;
  }

  .app-capture__light,
  .app-capture__dark {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* The three theme states global.css documents: OS default, chose dark, chose light. */
  .app-capture__light {
    display: block;
  }

  .app-capture__dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .app-capture__light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .app-capture__dark {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .app-capture__light {
    display: none;
  }
  :global(:root[data-theme='dark']) .app-capture__dark {
    display: block;
  }
</style>
