---
import AppStatusBar from './AppStatusBar.astro'
import FeatureHeader from './FeatureHeader.astro'
import iconFuel from '@/assets/app/icon-fuel.webp'

/**
 * The app's Fuel hub, ported from myridesg-v2/apps/mobile:
 *   features/fuel/FuelHub.tsx           → the section order
 *   features/fuel/FuelLogSeamCard.tsx   → the card straddling the wave seam
 *   features/hub/RecentLogSection.tsx   → "Recent fill-ups" + "View all"
 *   components/FeatureScreen.tsx        → header + seam layout
 *
 * Two deliberate departures from the flat capture this replaced, both under
 * the Claim Guardrails in AGENTS.md:
 *
 *   1. The cheapest-price tile no longer names a petrol brand. In the app that
 *      value is live data; frozen into marketing HTML it becomes an unbacked
 *      claim about a named real company's pricing.
 *   2. The fill-up rows carry a neutral pump glyph instead of the brands'
 *      logos. Station names stay — a fuel log that cannot say where you filled
 *      up is not a fuel log — but reproducing third-party marks on a marketing
 *      page is a different question from showing them inside the product.
 */

const FILL_UPS = [
  { station: 'Caltex · 95', detail: '9.6 L · Honda CB400', dollars: '$28', cents: '.61', date: '12 Jul' },
  { station: 'Shell · 95', detail: '10.4 L · Honda CB400', dollars: '$31', cents: '.72', date: '3 Jul' },
  { station: 'SPC · 95', detail: '9.8 L · Honda CB400', dollars: '$28', cents: '.91', date: '24 Jun' },
]
---

<div class="fuel">
  <AppStatusBar time="10:31" />
  <FeatureHeader title="Fuel" tagline="Every fill-up, tracked." icon={iconFuel} />

  <div class="fuel__body">
    {/* Seam card — pulled up so it sits half on the band, half on the body. */}
    <div class="fuel__seam">
      <span class="fuel__seam-plus" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
          <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
        </svg>
      </span>

      <span class="fuel__seam-text">
        <span class="fuel__seam-title">Log fill-up</span>
        <span class="fuel__seam-sub">Litres, cost, odometer</span>
      </span>

      <span class="fuel__seam-camera" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2.2l1.1-1.8h7.4L16.3 7h3.2A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5Z" stroke-linejoin="round"></path>
          <circle cx="12" cy="13" r="3.4"></circle>
        </svg>
      </span>
    </div>

    <div class="fuel__cheapest">
      <p class="fuel__tile-label">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 20V5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v15" stroke-linecap="round"></path>
          <path d="M3 20h11M6.5 8.5h4M16 10.5h2.5V17a1.6 1.6 0 0 0 3.2 0V9.2l-2.4-2.4" stroke-linecap="round"></path>
        </svg>
        Cheapest RON95 nearby
      </p>
      <p class="fuel__cheapest-value">S$2.89/L</p>
    </div>

    <div class="fuel__tiles">
      <div class="fuel__tile">
        <p class="fuel__tile-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="8.4"></circle>
            <path d="m12 12 4-3" stroke-linecap="round"></path>
          </svg>
          Your economy
        </p>
        <p class="fuel__tile-value">22.0 km/L</p>
      </div>

      <div class="fuel__tile">
        <p class="fuel__tile-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M19 10.5c0 5-7 11-7 11s-7-6-7-11a7 7 0 1 1 14 0Z" stroke-linejoin="round"></path>
            <circle cx="12" cy="10.2" r="2.4"></circle>
          </svg>
          Stations
        </p>
        <p class="fuel__tile-value fuel__tile-value--soft">Soon</p>
      </div>
    </div>

    <div class="fuel__section-head">
      <h4 class="fuel__section-title">Recent fill-ups</h4>
      <span class="fuel__viewall">View all →</span>
    </div>

    <div class="fuel__rows">
      {
        FILL_UPS.map((row) => (
          <div class="fuel__row">
            <span class="fuel__row-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 20V5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v15" stroke-linecap="round" />
                <path d="M3 20h11M6.5 8.5h4M16 10.5h2.5V17a1.6 1.6 0 0 0 3.2 0V9.2l-2.4-2.4" stroke-linecap="round" />
              </svg>
            </span>

            <span class="fuel__row-text">
              <span class="fuel__row-title">{row.station}</span>
              <span class="fuel__row-sub">{row.detail}</span>
            </span>

            <span class="fuel__row-amount">
              <span class="fuel__row-money">
                <b>{row.dollars}</b>
                {row.cents}
              </span>
              <span class="fuel__row-date">{row.date}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .fuel {
    position: relative;
    height: 100%;
    overflow: hidden;
    background: var(--app-bg);
  }

  .fuel__body {
    padding: 0 1em 1.4em;
  }

  /* ── Seam card ──────────────────────────────────────────────────────────
     SEAM_PULL in FeatureScreen.tsx: half on the band, half on the body. */
  .fuel__seam {
    /* The header is positioned, so without a stacking position of its own the
       seam card paints under the band instead of straddling its edge. */
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.9em;
    margin-top: -1.6em;
    padding: 0.85em 1em;
    border-radius: 1.1em;
    background: var(--app-card);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  .fuel__seam-plus {
    display: grid;
    place-items: center;
    inline-size: 2.4em;
    block-size: 2.4em;
    flex-shrink: 0;
    border-radius: 0.8em;
    background: color-mix(in oklab, var(--app-primary) 12%, transparent);
    color: var(--app-primary);
  }

  .fuel__seam-plus svg {
    inline-size: 1.3em;
    block-size: 1.3em;
  }

  .fuel__seam-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-inline-size: 0;
  }

  .fuel__seam-title {
    font-size: 1.15em;
    font-weight: 600;
    color: var(--app-fg);
  }

  .fuel__seam-sub {
    font-size: 0.9em;
    color: var(--app-muted-fg);
  }

  .fuel__seam-camera {
    padding-left: 0.9em;
    border-left: 1px solid var(--app-border);
    color: var(--app-muted-fg);
  }

  .fuel__seam-camera svg {
    display: block;
    inline-size: 1.4em;
    block-size: 1.4em;
  }

  /* ── Tiles ──────────────────────────────────────────────────────────────*/
  .fuel__cheapest {
    margin-top: 1em;
    padding: 0.8em 0.9em;
    border: 1px solid color-mix(in oklab, var(--app-primary) 35%, transparent);
    border-radius: 1.1em;
    background: color-mix(in oklab, var(--app-primary) 9%, var(--app-bg));
  }

  .fuel__cheapest .fuel__tile-label {
    /* --app-primary measured 4.23:1 here in light and 3.56:1 in dark — under
       AA for 13.6px text either way. The app's destructive red clears it in
       light (5.67:1); in dark, muted-fg (6.77:1) keeps the label quiet while
       the red border and tint carry the emphasis. Same light-dark() pattern as
       the .app-screen tokens in global.css. */
    color: light-dark(var(--app-destructive), var(--app-muted-fg));
  }

  .fuel__cheapest-value {
    margin-top: 0.2em;
    font-size: 1.35em;
    font-weight: 600;
    color: var(--app-fg);
  }

  .fuel__tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6em;
    margin-top: 0.6em;
  }

  .fuel__tile {
    padding: 0.8em 0.9em;
    border: 1px solid var(--app-border);
    border-radius: 1.1em;
    background: var(--app-card);
  }

  .fuel__tile-label {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.85em;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--app-muted-fg);
  }

  .fuel__tile-label svg {
    inline-size: 1.2em;
    block-size: 1.2em;
    flex-shrink: 0;
  }

  .fuel__tile-value {
    margin-top: 0.2em;
    font-size: 1.25em;
    font-weight: 600;
    color: var(--app-fg);
  }

  .fuel__tile-value--soft {
    color: var(--app-muted-fg);
    font-weight: 500;
  }

  /* ── Recent fill-ups ────────────────────────────────────────────────────*/
  .fuel__section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 1.4em;
  }

  .fuel__section-title {
    font-family: var(--font-sans);
    font-size: 1.15em;
    font-weight: 600;
    color: var(--app-fg);
  }

  .fuel__viewall {
    font-size: 0.9em;
    color: var(--app-muted-fg);
  }

  .fuel__row {
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding-block: 0.7em;
  }

  .fuel__row + .fuel__row {
    border-top: 1px solid color-mix(in oklab, var(--app-border) 60%, transparent);
  }

  .fuel__row-icon {
    display: grid;
    place-items: center;
    inline-size: 2.2em;
    block-size: 2.2em;
    flex-shrink: 0;
    border: 1px solid var(--app-border);
    border-radius: 999px;
    background: var(--app-card);
    color: var(--app-muted-fg);
  }

  .fuel__row-icon svg {
    inline-size: 1.15em;
    block-size: 1.15em;
  }

  .fuel__row-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-inline-size: 0;
  }

  .fuel__row-title {
    font-size: 1.05em;
    font-weight: 600;
    color: var(--app-fg);
  }

  .fuel__row-sub {
    font-size: 0.85em;
    color: var(--app-muted-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fuel__row-amount {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  /* Dollars heavy, cents light — the app's own emphasis, so a column of
     amounts scans on the figure that matters. */
  .fuel__row-money {
    font-size: 1.05em;
    color: var(--app-fg);
    font-variant-numeric: tabular-nums;
  }

  .fuel__row-money b {
    font-weight: 700;
  }

  .fuel__row-date {
    font-size: 0.85em;
    color: var(--app-muted-fg);
  }
</style>
