---
import AppStatusBar from './AppStatusBar.astro'
import FeatureHeader from './FeatureHeader.astro'
import iconWorkshops from '@/assets/app/icon-workshops.webp'

/**
 * The app's Workshops directory, ported from myridesg-v2/apps/mobile:
 *   features/workshops/WorkshopsSearch.tsx        → search field + list
 *   features/workshops/WorkshopCard.tsx           → name, area, action row
 *   features/workshops/WorkshopsSearchSeamCard.tsx
 *
 * Two deliberate departures from the flat capture this replaced, both required
 * by the Claim Guardrails in AGENTS.md, and both following the precedent
 * already set in DemoGarage.tsx on the feat/demo branch:
 *
 *   1. The workshop names are invented, and match the ones that demo already
 *      uses. The capture showed names that read as real Singapore businesses.
 *   2. The section reads "Nearby", not "Top rated". A ranking label is a
 *      rating claim, and this site may not publish ratings for a named
 *      business it has not verified.
 *
 * In the app both are real: the names come from the listings table and the
 * ordering from a rating the rider can see the source of.
 */

const WORKSHOPS = [
  { name: 'Northside Moto', area: 'Yishun' },
  { name: 'Central Bike Care', area: 'Bishan' },
]

const ACTIONS = [
  {
    label: 'Call',
    path: 'M6.2 3.5h3l1.5 3.8-1.9 1.2a11 11 0 0 0 4.7 4.7l1.2-1.9 3.8 1.5v3a1.7 1.7 0 0 1-1.9 1.7A14.8 14.8 0 0 1 4.5 5.4 1.7 1.7 0 0 1 6.2 3.5Z',
  },
  {
    label: 'WhatsApp',
    path: 'M20 11.5a7.6 7.6 0 0 1-11.3 6.7L4 19.5l1.4-4.5A7.6 7.6 0 1 1 20 11.5Z',
  },
  {
    label: 'Directions',
    path: 'M19 10.5c0 5-7 11-7 11s-7-6-7-11a7 7 0 1 1 14 0Z',
  },
  {
    label: 'Website',
    path: 'M12 3.6a8.4 8.4 0 1 0 0 16.8 8.4 8.4 0 0 0 0-16.8Zm0 0c2.2 2.2 3.2 5.1 3.2 8.4S14.2 18.2 12 20.4m0-16.8C9.8 5.8 8.8 8.7 8.8 12s1 6.2 3.2 8.4M3.9 9.4h16.2M3.9 14.6h16.2',
  },
]
---

<div class="ws">
  <AppStatusBar time="10:34" />
  <FeatureHeader title="Workshops" tagline="Find a mechanic." icon={iconWorkshops} />

  <div class="ws__body">
    <div class="ws__search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="6.4"></circle>
        <path d="m20 20-4.4-4.4" stroke-linecap="round"></path>
      </svg>
      Search workshops
    </div>

    <p class="ws__label">Nearby</p>

    <div class="ws__list">
      {
        WORKSHOPS.map((shop) => (
          <div class="ws__card">
            <p class="ws__name">{shop.name}</p>
            <p class="ws__area">{shop.area}</p>

            <div class="ws__actions">
              {ACTIONS.map((action) => (
                <span class="ws__action">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    aria-hidden="true"
                  >
                    <path d={action.path} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {action.label}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .ws {
    position: relative;
    height: 100%;
    overflow: hidden;
    background: var(--app-bg);
  }

  .ws__body {
    padding: 1.1em 1em 1.4em;
  }

  .ws__search {
    display: flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.85em 1em;
    border: 1px solid var(--app-border);
    border-radius: 1.1em;
    background: var(--app-muted);
    /* --app-muted-fg alone measured 4.41:1 on this field in light (4.70 dark)
       — under AA. Nudging it 15% toward --app-fg clears 4.5 in BOTH schemes
       (5.7 / 5.45) while still reading as placeholder text, not entered text.
       Derived from the app's own tokens, like the alpha utilities above. */
    color: color-mix(in oklab, var(--app-muted-fg) 85%, var(--app-fg));
    font-size: 1.05em;
  }

  .ws__search svg {
    inline-size: 1.2em;
    block-size: 1.2em;
    flex-shrink: 0;
  }

  .ws__label {
    margin-top: 1.1em;
    font-size: 0.85em;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--app-muted-fg);
  }

  .ws__list {
    display: flex;
    flex-direction: column;
    gap: 0.7em;
    margin-top: 0.5em;
  }

  .ws__card {
    padding: 0.95em 1em;
    border: 1px solid var(--app-border);
    border-radius: 1.1em;
    background: var(--app-card);
  }

  .ws__name {
    font-size: 1.15em;
    font-weight: 600;
    color: var(--app-fg);
  }

  .ws__area {
    font-size: 0.9em;
    color: var(--app-muted-fg);
  }

  /* Wraps to a second line at four actions, exactly as the app's row does at
     this width — Website drops under Call. */
  .ws__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
    margin-top: 0.75em;
  }

  .ws__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.45em 0.75em;
    border: 1px solid var(--app-border);
    border-radius: 999px;
    color: var(--app-fg);
    font-size: 0.9em;
  }

  .ws__action svg {
    inline-size: 1.05em;
    block-size: 1.05em;
    flex-shrink: 0;
  }
</style>
