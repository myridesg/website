---
// Icons are inline SVG rather than lucide-react: these are decorative and
// static, and importing a React icon set here would turn a zero-JS section
// into a hydrated island for no benefit.
//
// Note the petrol-price wording. The brief forbids describing the feed as
// real-time when its cadence is not, so this says "updated regularly", not
// "live".
type Tool = {
  title: string
  body: string
  path: string
  /** Contextual link to the matching feature page, when one exists. */
  href?: string
  linkLabel?: string
}

const TOOLS: Tool[] = [
  {
    title: 'Petrol prices',
    body: 'Compare listed pump prices across stations, updated regularly.',
    path: 'M3 22h12V10l-3-3H3v15ZM15 12h2a2 2 0 0 1 2 2v4a1 1 0 0 0 2 0V9l-3-3M6 11h6',
  },
  {
    title: 'Causeway cameras',
    body: 'Check conditions at both crossings before heading north.',
    path: 'M14 5H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2ZM22 8l-6 4 6 4V8Z',
  },
  {
    title: 'COE calculator',
    body: 'Work through the figures before your next purchase.',
    path: 'M8 3H16A2 2 0 0 1 18 5V19A2 2 0 0 1 16 21H8A2 2 0 0 1 6 19V5A2 2 0 0 1 8 3ZM10 7h4M10 11h.01M14 11h.01M10 15h.01M14 15h.01',
    href: '/motorcycle-coe-calculator/',
    linkLabel: 'Try the COE calculator',
  },
  {
    title: 'Bike guides',
    body: 'Licensing classes, road tax tables and routine maintenance checks.',
    path: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z',
  },
]
---

<section class="border-t border-white/8 bg-black pb-20 md:pb-28">
  <div class="shell">
    <p class="eyebrow text-ember-on-dark">Rider tools</p>

    <h2 class="mt-4 max-w-xl text-display-sm text-on-dark md:text-display">
      Everything else you check before a ride.
    </h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        TOOLS.map((tool) => (
          <article class="rounded-xl border border-white/10 bg-white/6 p-6 transition-colors hover:bg-white/10">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-ember-on-dark"
              aria-hidden="true"
            >
              <path d={tool.path} />
            </svg>

            <h3 class="mt-4 text-lg font-semibold text-on-dark">{tool.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-white/50">{tool.body}</p>
            {tool.href && (
              <a
                href={tool.href}
                class="mt-3 inline-block text-sm font-semibold text-ember-on-dark hover:underline"
              >
                {tool.linkLabel} →
              </a>
            )}
          </article>
        ))
      }
    </div>

    <a
      href="/rider-tools/"
      class="mt-10 inline-block text-md font-semibold text-ember-on-dark hover:underline"
    >
      See all rider tools →
    </a>
  </div>
</section>
