---
import { getImage } from 'astro:assets'
import StoreButtons from './StoreButtons.astro'
import heroDesktop from '@/assets/hero-carpark-desktop.jpg'
import heroMobile from '@/assets/hero-carpark-mobile.jpg'

// Art direction: the two files are different compositions, not crops of each
// other. The desktop frame is 2.35:1 with the bike centre-right; the mobile
// frame is 9:16 with the bike high and quiet wet deck below for the copy.
//
// A real <picture> with a media <source> is used rather than two <Image>
// elements toggled by CSS, because CSS toggling still downloads both. This is
// the LCP element — exactly one file must be fetched.
const desktop = await getImage({
  src: heroDesktop,
  widths: [1280, 1920, 2560, 3168],
  format: 'webp',
})

const mobile = await getImage({
  src: heroMobile,
  widths: [640, 828, 1080, 1536],
  format: 'webp',
})
---

<section class="relative isolate flex min-h-dvh items-end overflow-hidden bg-black md:items-center">
  <picture>
    <source
      media="(min-width: 768px)"
      srcset={desktop.srcSet.attribute}
      sizes="100vw"
      type="image/webp"
    />
    <img
      src={mobile.src}
      srcset={mobile.srcSet.attribute}
      sizes="100vw"
      width={heroMobile.width}
      height={heroMobile.height}
      alt="A motorcycle parked on an HDB multi-storey carpark rooftop at night, with lit Singapore housing blocks and the city skyline behind"
      class="absolute inset-0 -z-10 size-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </picture>

  <!-- Scrim. Mobile reads bottom-up (copy over the wet deck); desktop reads
       left-to-right (copy over the dark pillar and sky).
       The mobile stops are deliberate: solid to 38% so the copy sits on real
       ground, then a fast falloff that clears by 70% and leaves the bike,
       HDB blocks and skyline reading cleanly in the upper frame. Without the
       hard early stop the bike sits half-veiled behind the headline and looks
       like an accident rather than a composition. -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-black from-38% via-black/60 via-58% to-transparent to-72% md:bg-gradient-to-r md:from-black/92 md:from-0% md:via-black/55 md:via-45% md:to-transparent md:to-75%"
  >
  </div>

  <div class="shell pb-16 pt-28 md:py-32">
    <div class="max-w-xl">
      <p class="eyebrow text-ember-on-dark">Made for Singapore riders</p>

      <h1 class="mt-4 text-display-lg text-on-dark md:text-display-xl lg:text-display-2xl">
        Your motorcycle <br />maintenance app.
      </h1>

      <p class="mt-5 max-w-md text-lg leading-relaxed text-white/72 md:mt-6">
        Your bike, sorted. Record servicing, mileage and fuel costs, keep renewal
        dates together, and browse Singapore workshops. Available on iOS and Android.
      </p>

      <StoreButtons tone="light" class="mt-8 md:mt-9" />

      <a
        href="/motorcycle-maintenance-app/"
        class="mt-6 inline-block text-md text-on-dark underline underline-offset-4 hover:opacity-80"
      >
        Explore maintenance tracking
      </a>

      <p class="mt-5 text-sm text-white/55">
        Free to start
      </p>
    </div>
  </div>
</section>
