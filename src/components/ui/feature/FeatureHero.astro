---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro'
import StoreButtons from '@/components/ui/StoreButtons.astro'

/**
 * A feature page's opening, on the home page's studio wall: the breadcrumb
 * as the eyebrow, the headline in heavy capitals with its full stop in
 * ember (as the home page's h1), the lead and the store buttons. Beside it
 * (under it, on a phone) the stage: the app preview. The row of 3D objects
 * over the phone is the home page's alone.
 *
 * The preview is the page's own <figure>, passed in as the slot and left
 * exactly as the page wrote it: the app screenshots are replaced there,
 * separately from this layout.
 */
interface Props {
  /** The page's breadcrumb label, after Home. */
  crumb: string
  /** One sentence ending in a full stop. */
  headline: string
  lead: string
}

const { crumb, headline, lead } = Astro.props
const words = headline.replace(/\.$/, '')
---

<section class="feature-hero" data-analytics-location="hero">
  <div class="feature-hero__inner">
    <div class="feature-hero__copy">
      <div class="feature-hero__crumbs">
        <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: crumb }]} />
      </div>
      <h1 class="feature-hero__title">{words}<span class="feature-hero__dot">.</span></h1>
      <p class="feature-hero__lead">{lead}</p>
      <div class="feature-hero__ask">
        <StoreButtons />
        <p class="feature-hero__note">Available on iOS and Android.</p>
      </div>
    </div>

    <div class="feature-hero__stage">
      <slot />
    </div>
  </div>
</section>
