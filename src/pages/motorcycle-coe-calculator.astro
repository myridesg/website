---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import CoeCalculator from '@/components/ui/guide/CoeCalculator.astro'
import { breadcrumbEntity, entityId, faqPageEntity, webPageEntity, APP_PATH, ORGANIZATION_PATH } from '@/lib/seo'
import FeatureHero from '@/components/ui/feature/FeatureHero.astro'
import FeatureExplain from '@/components/ui/feature/FeatureExplain.astro'
import FeatureSteps from '@/components/ui/feature/FeatureSteps.astro'
import FeatureRelated from '@/components/ui/feature/FeatureRelated.astro'
import FeatureFaq from '@/components/ui/feature/FeatureFaq.astro'
import FeatureAsk from '@/components/ui/feature/FeatureAsk.astro'
import '@/styles/feature.css'

const title = 'Motorcycle COE Calculator for Singapore Riders'
const description = 'Work out the cost of renewing a Category D motorcycle COE. Enter the PQP and renewal term to see the total, yearly and monthly cost of the renewal.'
const canonical = new URL('/motorcycle-coe-calculator/', Astro.site)
const site = Astro.site!

const questions = [
  {
    q: 'What does this motorcycle COE calculator work out?',
    a: 'What a COE renewal costs spread over its term. Give it the PQP you would pay and the number of years you would renew for, and it shows the total, the cost per year and the cost per month. It does the arithmetic on your figures only — it does not look up a premium for you.',
  },
  {
    q: 'What is the PQP?',
    a: 'The Prevailing Quota Premium — what you pay to renew a COE without bidding. LTA works it out as the moving average of COE prices over the last three months, so it moves from month to month.',
  },
  {
    q: 'What is the difference between the 5-year and 10-year renewal?',
    a: 'A 10-year renewal costs 100% of the PQP. A 5-year renewal costs 50% of the PQP but can only be taken once — a motorcycle renewed for five years must be deregistered when the term ends.',
  },
  {
    q: 'Does the calculator include road tax and insurance?',
    a: 'No. It spreads the COE premium only, as the note under the calculator says. Road tax, insurance and servicing sit on top, and MyRideSG can remind you before each of those renews.',
  },
  {
    q: 'Where do I find the current PQP?',
    a: 'Check LTA’s OneMotoring website — the link is on this page. The premium changes, so enter the current figure rather than one you noted down months ago.',
  },
]

// The in-browser tool itself. It is the page's main entity: the calculator is
// what the page is here for, distinct from the MobileApplication, which stays
// the app entity shared across the site.
const calculatorId = new URL('/motorcycle-coe-calculator/#calculator', Astro.site).href

const webApplication = {
  '@type': 'WebApplication',
  '@id': calculatorId,
  name: 'Motorcycle COE renewal calculator',
  url: canonical.href,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  // The sums run in an inline script in the page; without JavaScript the
  // inputs do nothing.
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'SGD',
  },
  provider: { '@id': new URL(ORGANIZATION_PATH, Astro.site).href },
}

const structuredData = [
  webPageEntity(site, {
    path: '/motorcycle-coe-calculator/',
    name: title,
    description,
    about: { '@id': entityId(site, APP_PATH) },
    // The in-browser tool is what the page is here for.
    mainEntity: { '@id': calculatorId },
  }),
  breadcrumbEntity(site, '/motorcycle-coe-calculator/', [
    { name: 'Home', href: '/' },
    { name: 'Motorcycle COE calculator' },
  ]),
  webApplication,
  // The questions rendered in the FAQ section below, hung off this page's
  // WebPage with a stable @id and isPartOf.
  faqPageEntity(site, '/motorcycle-coe-calculator/', questions),
]

const LTA_COE_URL =
  'https://onemotoring.lta.gov.sg/content/onemotoring/home/buying/upfront-vehicle-costs/certificate-of-entitlement--coe-.html'
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <SiteNav />
  <main class="feature-page">
    {/* The calculator is the stage: on this page the tool is the hero. */}
    <FeatureHero
      crumb="COE calculator"
      headline="What your COE renewal costs."
      lead="A motorcycle COE calculator for the decision every Singapore rider faces as the tenth year approaches: what the renewal works out to per year and per month, from the PQP you would actually pay."
    >
      <div class="coe-stage" id="calculator">
        <CoeCalculator />
        <p class="coe-stage__note">
          The inputs start empty on purpose. COE premiums move, so bring the
          current PQP from <a href={LTA_COE_URL} target="_blank" rel="noopener noreferrer">LTA OneMotoring</a>,
          type it in, and the sums update as you type.
        </p>
      </div>
    </FeatureHero>

    <div class="tool-band tool-band--paper">
      <FeatureExplain
        headline="How COE renewal works for motorcycles."
        paragraphs={[
          'A motorcycle sits in Category D. Its COE is valid for ten years from registration, and when it runs out you have two choices: deregister the bike, or renew the COE by paying the Prevailing Quota Premium — no bidding involved.',
          'The PQP is the moving average of COE prices over the last three months, so it moves with the market. Renew for ten years and you pay it in full; renew for five and you pay half, but a five-year renewal can only be taken once — the bike must be deregistered when that term ends.',
        ]}
        cardTitle="Worth knowing before you renew"
      >
        <dl class="card-rows">
          {[
            ['Renewing', 'No bidding needed — you pay the PQP for your category'],
            ['After expiry', 'The bike cannot be ridden while its COE has lapsed'],
            ['5-year term', '50% of the PQP, once only — deregister when it ends'],
            ['10-year term', '100% of the PQP'],
            ['PARF rebate', 'Renewing means giving up any PARF rebate that would have been paid at deregistration'],
            ['Where to check', 'The current PQP is published on LTA OneMotoring'],
          ].map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </FeatureExplain>
    </div>

    <div class="tool-band tool-band--wall">
      <FeatureSteps
        headline="The same calculator rides in your pocket."
        steps={[
          ['In the app', 'The MyRideSG app carries this calculator with the five- and ten-year terms side by side, and a place to compare the renewal against the price of a new bike.'],
          ['Alongside your dates', 'Save your bike in MyRideSG and the COE expiry sits with your road tax and insurance dates, with a reminder before each one.'],
          ['With the numbers that follow', 'The COE is one line of the budget. Track the rest — petrol, parking, servicing — as you go.'],
        ]}
      />
    </div>

    <FeatureFaq headline="Questions about COE renewal." questions={questions} />

    <FeatureRelated
      headline="Beyond the renewal sum."
      intro="The calculator is one of the tools in MyRideSG. The rest of your bike’s paperwork sits beside it."
      links={[
        { href: '/motorcycle-renewal-reminders/', title: 'Renewal reminders', line: 'Road tax, insurance and COE renewals, flagged before they lapse.', object: 'receipt' },
        { href: '/motorcycle-expense-tracker/', title: 'Motorcycle expense tracker', line: 'Fuel, mileage and running costs, totalled in Singapore dollars.', object: 'chart' },
        { href: '/rider-tools/', title: 'Rider tools', line: 'Causeway cameras and petrol prices, in the same app.', object: 'cams' },
      ]}
    >
      <p class="feature-related__more">
        For the full picture — bidding, quotas and rebates — read our guide
        to <a href="/guides/motorcycle-coe-singapore/">motorcycle COE in Singapore</a>.
      </p>
    </FeatureRelated>

    <FeatureAsk
      headline="Plan the renewal before it plans you."
      note="The COE calculator — here on the web, and in MyRideSG on iOS and Android."
    />
  </main>
  <SiteFooter />
</BaseLayout>
