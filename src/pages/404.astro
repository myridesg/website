---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import { Image } from 'astro:assets'
import PageHead from '@/components/ui/PageHead.astro'
import { OBJECTS, objectStyle, objectWidths } from '@/components/ui/feature/objects'
import '@/styles/reading.css'

// Astro emits this as dist/404.html rather than 404/index.html, which is the
// filename both Cloudflare Pages and nginx look for.
//
// noindex matters here: without a 404 page the host falls back to serving the
// homepage with a 200, and search engines read that as a soft 404 on every
// mistyped URL.
---

<BaseLayout
  title="Page not found"
  description="That page could not be found. Everything on MyRideSG is reachable from the homepage."
  noindex
>
  <SiteNav />

  <main class="feature-page">
    <PageHead
      class="page-head--lost"
      eyebrow="Error 404"
      title="We could not find that page."
      lead="The link may be out of date, or the address may have a small typo in it. Everything on the site is reachable from the homepage."
    >
      <div class="page-actions">
        <a href="/" class="page-button">Back to the homepage</a>
        <a href="/#detail">Read the FAQ</a>
      </div>

      <ul slot="stage" class="feature-hero__objects" role="list" aria-hidden="true">
        <li class="tool__art" style={objectStyle('map')}>
          <span class="tool__drop">
            <Image
              src={OBJECTS.map.image}
              alt=""
              widths={objectWidths('map')}
              sizes="13rem"
              loading="eager"
              class="tool__icon"
            />
          </span>
        </li>
      </ul>
    </PageHead>
  </main>

  <SiteFooter />
</BaseLayout>
