---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import GuideNav from '@/components/ui/guide/GuideNav.astro'
import GuideGrid from '@/components/ui/guide/GuideGrid.astro'
import FeatureAsk from '@/components/ui/feature/FeatureAsk.astro'
import { contentRepo } from '@/lib/content'
import { GUIDE_GROUPS, topicPath } from '@/lib/guide-navigation'
import { loadGuides } from '@/lib/guide-data'
import { breadcrumbEntity, webPageEntity } from '@/lib/seo'
import '@/styles/guides.css'

// Build-time fetch. Every route on this site prerenders (AGENTS.md rule 1),
// so new guides appear on the next build, not on the next request.
const guides = (await loadGuides(contentRepo)).filter((entry) => entry.listed)

// One section per topic that has guides, newest first, five to a section: the
// rest are on the topic's own page.
const SHOWN = 5
const groups = GUIDE_GROUPS.map((group) => {
  const all = guides.filter((entry) => entry.topic === group.id)
  return { ...group, all, shown: all.slice(0, SHOWN) }
}).filter((group) => group.all.length > 0)

// The index sits one level under Home, so its breadcrumb trail is a fixed
// two steps. Individual guides carry their own three-step list in [slug].astro.
const structuredData = [
  webPageEntity(Astro.site!, {
    path: '/guides/',
    type: 'CollectionPage',
    name: 'Motorcycle Maintenance & Riding Guides Singapore',
    description:
      'Maintenance, COE, road tax and insurance guides, written for Singapore motorcycle riders.',
    // The collection itself is what the page presents; each member guide is
    // listed in the ItemList below.
    mainEntity: { '@id': new URL('/guides/#guides', Astro.site).href },
  }),
  breadcrumbEntity(Astro.site!, '/guides/', [
    { name: 'Home', href: '/' },
    { name: 'Riding guides' },
  ]),
  {
    '@type': 'ItemList',
    '@id': new URL('/guides/#guides', Astro.site).href,
    // Empty when Sanity is not configured: the page renders the same "no
    // guides yet" state, and the list says so honestly with zero items.
    numberOfItems: guides.length,
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.article.title,
      url: new URL(`/guides/${guide.article.slug}/`, Astro.site).href,
    })),
  },
]
---

<BaseLayout
  title="Motorcycle Maintenance & Riding Guides Singapore"
  description="Maintenance, COE, road tax and insurance guides, written for Singapore motorcycle riders."
  structuredData={structuredData}
>
  <SiteNav />

  <main class="feature-page guides-page">
    {groups.length > 0 && <GuideNav topics={groups.map((group) => group.id)} current="home" />}

    <div class="guides-wrap">
      <header class="guides-head">
        <h1 class="guides-head__title">Motorcycle guides for Singapore riders</h1>
        <p class="guides-head__lead">
          Maintenance, COE, road tax and insurance, written for Singapore riders.
        </p>
        <p class="guides-head__note">
          Keeping a service record? Explore the{' '}
          <a href="/motorcycle-maintenance-app/">MyRideSG motorcycle maintenance app</a>.
        </p>
      </header>

      {
        guides.length === 0 ? (
          <p class="guides-empty">
            There are no guides published yet. They will appear here as they go live.
          </p>
        ) : (
          groups.map((group) => (
            <section id={group.id} class="guide-section" aria-labelledby={`${group.id}-title`}>
              <div class="guide-section__head">
                <h2 id={`${group.id}-title`} class="guide-section__title">{group.title}</h2>
                {group.all.length > SHOWN && (
                  <a class="guide-section__all" href={topicPath(group.id)}>
                    See all {group.all.length} guides →
                  </a>
                )}
              </div>
              <GuideGrid guides={group.shown} />
            </section>
          ))
        )
      }
    </div>

    <FeatureAsk
      headline="Keep your motorcycle records close."
      note="Log services, fuel and renewal dates in MyRideSG on iOS or Android."
    />
  </main>

  <SiteFooter />
</BaseLayout>
