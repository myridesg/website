---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import { listGuideArticles } from '@/content/usecases'
import { contentRepo } from '@/lib/content'
import { groupGuides } from '@/lib/guide-navigation'
import { breadcrumbEntity, webPageEntity } from '@/lib/seo'

// Build-time fetch. Every route on this site prerenders (AGENTS.md rule 1),
// so new guides appear on the next build, not on the next request.
const guides = await listGuideArticles(contentRepo)
const groups = groupGuides(guides)

const dateFormat = new Intl.DateTimeFormat('en-SG', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

// The index sits one level under Home, so its breadcrumb trail is a fixed
// two steps. Individual guides carry their own three-step list in [slug].astro.
const structuredData = [
  webPageEntity(Astro.site!, {
    path: '/guides/',
    type: 'CollectionPage',
    name: 'Motorcycle Maintenance & Riding Guides Singapore',
    description:
      'Maintenance, COE, road tax and insurance guides, written for Singapore motorcycle riders.',
    // The collection itself is what the page presents; each member guide is
    // listed in the ItemList below.
    mainEntity: { '@id': new URL('/guides/#guides', Astro.site).href },
  }),
  breadcrumbEntity(Astro.site!, '/guides/', [
    { name: 'Home', href: '/' },
    { name: 'Riding guides' },
  ]),
  {
    '@type': 'ItemList',
    '@id': new URL('/guides/#guides', Astro.site).href,
    // Empty when Sanity is not configured: the page renders the same "no
    // guides yet" state, and the list says so honestly with zero items.
    numberOfItems: guides.length,
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: new URL(`/guides/${guide.slug}/`, Astro.site).href,
    })),
  },
]
---

<BaseLayout
  title="Motorcycle Maintenance & Riding Guides Singapore"
  description="Maintenance, COE, road tax and insurance guides, written for Singapore motorcycle riders."
  structuredData={structuredData}
>
  <SiteNav />

  <main class="bg-paper pb-24 pt-32 md:pt-40">
    <div class="shell">
      <div class="mx-auto max-w-[46rem]">
        <p class="eyebrow text-red">Guides</p>

        <h1 class="mt-4 text-display-sm md:text-display">Motorcycle guides for Singapore riders</h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          Maintenance, COE, road tax and insurance, written for Singapore riders.
        </p>

        <p class="mt-5 leading-relaxed text-muted">
          Keeping a service record? Explore the
          <a href="/motorcycle-maintenance-app/" class="text-red underline underline-offset-2">
            MyRideSG motorcycle maintenance app
          </a>.
        </p>

        {
          guides.length === 0 ? (
            <p class="mt-14 rounded-xl bg-soft px-6 py-8 text-lg leading-relaxed text-ink/75">
              There are no guides published yet. They will appear here as they go
              live.
            </p>
          ) : (
            <>
              <nav aria-label="Guide topics" class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
                {groups.map((group) => (
                  <a href={`#${group.id}`} class="text-red underline underline-offset-2">
                    {group.title}
                  </a>
                ))}
              </nav>
              {groups.map((group) => (
                <section id={group.id} class="mt-14" aria-labelledby={`${group.id}-title`}>
                  <h2 id={`${group.id}-title`} class="text-2xl md:text-[1.75rem]">{group.title}</h2>
                  <p class="mt-3 leading-relaxed text-muted">{group.intro}</p>
                  <ul class="mt-7 flex flex-col">
                    {group.guides.map((guide) => (
                <li class="border-t border-ink/12 last:border-b">
                  <a
                    href={`/guides/${guide.slug}/`}
                    class="group flex flex-col gap-2 py-7 transition-opacity hover:opacity-70"
                  >
                    <time
                      class="eyebrow text-muted"
                      datetime={guide.publishedAt.toISOString()}
                    >
                      {dateFormat.format(guide.publishedAt)}
                    </time>

                    <h3 class="text-2xl md:text-[1.75rem]">{guide.title}</h3>

                    <p class="max-w-xl leading-relaxed text-muted">{guide.description}</p>
                  </a>
                </li>
                    ))}
                  </ul>
                </section>
              ))}
            </>
          )
        }
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
