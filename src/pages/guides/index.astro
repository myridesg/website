---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import PageHead from '@/components/ui/PageHead.astro'
import FeatureAsk from '@/components/ui/feature/FeatureAsk.astro'
import { listGuideArticles } from '@/content/usecases'
import { contentRepo } from '@/lib/content'
import { groupGuides } from '@/lib/guide-navigation'
import { breadcrumbEntity, webPageEntity } from '@/lib/seo'
import '@/styles/reading.css'

// Build-time fetch. Every route on this site prerenders (AGENTS.md rule 1),
// so new guides appear on the next build, not on the next request.
const guides = await listGuideArticles(contentRepo)
const groups = groupGuides(guides)

const dateFormat = new Intl.DateTimeFormat('en-SG', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

// The index sits one level under Home, so its breadcrumb trail is a fixed
// two steps. Individual guides carry their own three-step list in [slug].astro.
const structuredData = [
  webPageEntity(Astro.site!, {
    path: '/guides/',
    type: 'CollectionPage',
    name: 'Motorcycle Maintenance & Riding Guides Singapore',
    description:
      'Maintenance, COE, road tax and insurance guides, written for Singapore motorcycle riders.',
    // The collection itself is what the page presents; each member guide is
    // listed in the ItemList below.
    mainEntity: { '@id': new URL('/guides/#guides', Astro.site).href },
  }),
  breadcrumbEntity(Astro.site!, '/guides/', [
    { name: 'Home', href: '/' },
    { name: 'Riding guides' },
  ]),
  {
    '@type': 'ItemList',
    '@id': new URL('/guides/#guides', Astro.site).href,
    // Empty when Sanity is not configured: the page renders the same "no
    // guides yet" state, and the list says so honestly with zero items.
    numberOfItems: guides.length,
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: new URL(`/guides/${guide.slug}/`, Astro.site).href,
    })),
  },
]
---

<BaseLayout
  title="Motorcycle Maintenance & Riding Guides Singapore"
  description="Maintenance, COE, road tax and insurance guides, written for Singapore motorcycle riders."
  structuredData={structuredData}
>
  <SiteNav />

  <main class="feature-page">
    <PageHead
      crumbs={[{ name: 'Home', href: '/' }, { name: 'Riding guides' }]}
      title="Motorcycle guides for Singapore riders"
      lead="Maintenance, COE, road tax and insurance, written for Singapore riders."
    >
      <p class="page-head__note">
        Keeping a service record? Explore the{' '}
        <a href="/motorcycle-maintenance-app/">MyRideSG motorcycle maintenance app</a>.
      </p>
      {
        groups.length > 0 && (
          <nav aria-label="Guide topics" class="guide-topics">
            {groups.map((group) => (
              <a href={`#${group.id}`}>{group.title}</a>
            ))}
          </nav>
        )
      }
    </PageHead>

    <div class="guide-groups">
      {
        guides.length === 0 ? (
          <div class="guide-empty">
            <p>There are no guides published yet. They will appear here as they go live.</p>
          </div>
        ) : (
          groups.map((group) => (
            <section id={group.id} class="guide-group" aria-labelledby={`${group.id}-title`}>
              <div class="guide-group__head">
                <h2 id={`${group.id}-title`} class="home-title guide-group__title">{group.title}</h2>
                <p class="guide-group__intro">{group.intro}</p>
              </div>
              <ul class="guide-rows" role="list">
                {group.guides.map((guide) => (
                  <li class="guide-row">
                    <a href={`/guides/${guide.slug}/`}>
                      <time datetime={guide.publishedAt.toISOString()}>
                        {dateFormat.format(guide.publishedAt)}
                      </time>
                      <h3 class="guide-row__title">{guide.title}</h3>
                      <p class="guide-row__body">{guide.description}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )
      }
    </div>

    <FeatureAsk
      headline="Keep your motorcycle records close."
      note="Log services, fuel and renewal dates in MyRideSG on iOS or Android."
    />
  </main>

  <SiteFooter />
</BaseLayout>
