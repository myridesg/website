---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import PhoneFrame from '@/components/ui/PhoneFrame.astro'
import AppCapture from '@/components/ui/app/AppCapture.astro'
import fuelLight from '@/assets/app/captures/fuel-light.png'
import fuelDark from '@/assets/app/captures/fuel-dark.png'
import { breadcrumbEntity, entityId, faqPageEntity, webPageEntity, APP_PATH } from '@/lib/seo'
import FeatureHero from '@/components/ui/feature/FeatureHero.astro'
import FeatureExplain from '@/components/ui/feature/FeatureExplain.astro'
import FeatureRelated from '@/components/ui/feature/FeatureRelated.astro'
import FeatureFaq from '@/components/ui/feature/FeatureFaq.astro'
import FeatureAsk from '@/components/ui/feature/FeatureAsk.astro'
import '@/styles/feature.css'

const title = 'Rider Tools: Causeway Cams, Fuel Prices & COE'
const description = 'Check the Causeway cameras, compare RON95 petrol prices and work out a COE renewal — everyday rider tools in the MyRideSG app for Singapore.'
const site = Astro.site!
const pagePath = '/rider-tools/'

const questions = [
  {
    q: 'Does MyRideSG show Causeway cameras?',
    a: 'Yes. The app groups LTA traffic cameras at Woodlands Checkpoint and Tuas Second Link, so you can look at both crossings — and zoom into a fullscreen view — before you point the bike north.',
  },
  {
    q: 'How fresh are the Causeway camera images?',
    a: 'The app reads LTA’s traffic-image feed through data.gov.sg and re-fetches it about once a minute while the camera screen is open. How up to date a frame is depends on when LTA captured it, and each camera shows that time.',
  },
  {
    q: 'Can I compare RON95 petrol prices in the app?',
    a: 'Yes. MyRideSG lists pump prices by brand and grade, including RON95, and highlights the lowest, so you can compare before you ride to a station. Enter your fuel-card discount and the app shows the effective price per litre.',
  },
  {
    q: 'How often are the fuel prices updated?',
    a: 'A scheduled job refreshes the price board once a day, and the app shows when it was last updated. Pump prices can change between updates, so the screen says to treat the figures as indicative and verify at the pump.',
  },
  {
    q: 'Is the COE calculator the same as the one on this website?',
    a: 'The renewal arithmetic is the same. The app’s version puts the five- and ten-year terms side by side and can weigh the renewal against the price of a new bike; the web version on our COE calculator page keeps to the renewal sums.',
  },
]

const structuredData = [
  webPageEntity(site, {
    path: pagePath,
    name: title,
    description,
    about: { '@id': entityId(site, APP_PATH) },
  }),
  breadcrumbEntity(site, pagePath, [
    { name: 'Home', href: '/' },
    { name: 'Rider tools' },
  ]),
  // The questions rendered in the FAQ section below, hung off this page's
  // WebPage with a stable @id and isPartOf.
  faqPageEntity(site, pagePath, questions),
]

// Each tool's "good to know" facts, as label and value rows on its card.
const camsFacts = [
  ['Crossings', 'Woodlands Checkpoint and Tuas Second Link'],
  ['View', 'Fullscreen and zoomable, for each camera'],
  ['Feed', 'LTA traffic images, via data.gov.sg'],
  ['Refresh', 'Roughly every minute while the screen is open'],
]

const fuelFacts = [
  ['Prices', 'By brand and grade, including RON95'],
  ['Lowest', 'Highlighted on the screen'],
  ['Your discount', 'Enter it to see effective prices per litre'],
  ['Updates', 'Board refreshed once a day; update time shown in the app'],
]

const coeFacts = [
  ['Built for', 'Category D — motorcycles'],
  ['You enter', 'The PQP; the calculator does the sums'],
  ['It shows', 'Total, yearly and monthly cost of a renewal'],
  ['In the app', 'Next to your COE expiry date'],
]
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <SiteNav />
  <main class="feature-page">
    <FeatureHero
      crumb="Rider tools"
      headline="Tools you open before you ride."
      lead="A Causeway camera view for bikes at both checkpoints, RON95 petrol prices worth comparing, and a motorcycle COE calculator — the everyday rider tools inside MyRideSG, on iOS and Android."
      objects={['cams', 'petrol', 'coe']}
    >
      <figure class="mx-auto">
        <PhoneFrame width={300} chrome={false}>
          <AppCapture light={fuelLight} dark={fuelDark} alt="MyRideSG Fuel screen with sample data: this month's fuel spend, fill-up count and average km/L, a fuel economy chart and recent fill-ups" />
        </PhoneFrame>
        <figcaption class="mt-5 max-w-xs text-center text-sm leading-relaxed text-muted">
          Illustrative app preview with sample data.
        </figcaption>
      </figure>
    </FeatureHero>

    {/* The ids are the home page's links to each tool (home-content.ts). */}
    <div id="causeway-cams" class="tool-band tool-band--paper">
      <FeatureExplain
        headline="Causeway cameras for bikes, at both crossings."
        paragraphs={[
          'The queue you cannot see is the one that ruins the trip. MyRideSG pulls LTA’s traffic cameras at Woodlands Checkpoint and the Tuas Second Link into one screen, so you can look at both crossings, tap into a fullscreen view, and decide whether today is the day for the ride up.',
          'While the camera screen is open, the app re-fetches LTA’s traffic-image feed about once a minute, and each camera shows how long ago its frame was taken. The feed comes from data.gov.sg; how current an image is depends on when LTA captured it.',
        ]}
        cardTitle="Good to know"
      >
        <dl class="card-rows">
          {camsFacts.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </FeatureExplain>
    </div>

    <div id="fuel-prices" class="tool-band tool-band--flip">
      <FeatureExplain
        headline="Compare RON95 petrol prices before you fill."
        paragraphs={[
          'Petrol is a motorcycle’s biggest running cost, and the brands rarely move together. MyRideSG lists pump prices by brand and grade — RON95 included — and highlights the lowest, so choosing where to fill up stops being a guess.',
          'Add your fuel card or discount and the app shows the effective price per litre. The board is refreshed by a scheduled job once a day and the app shows when it was last updated — prices at the pump can differ, which is why the screen tells you to verify there.',
        ]}
        cardTitle="Good to know"
      >
        <dl class="card-rows">
          {fuelFacts.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </FeatureExplain>
    </div>

    <div id="coe-calculator" class="tool-band tool-band--paper">
      <FeatureExplain
        headline="The motorcycle COE calculator."
        paragraphs={[
          'Ten years arrive faster than any rider expects. The COE calculator works out what a Category D renewal costs per year and per month from the PQP you would pay, with the five- and ten-year terms side by side — and a place to weigh the renewal against the price of a new bike.',
        ]}
        cardTitle="Good to know"
      >
        <dl class="card-rows">
          {coeFacts.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <a class="card-link" href="/motorcycle-coe-calculator/">Open the COE calculator on the web</a>
      </FeatureExplain>
    </div>

    <FeatureRelated
      headline="Tools beside the paperwork."
      intro="The rider tools sit in the same app as your ownership records, so a cheap fill-up and a renewal deadline are never far apart."
      links={[
        { href: '/motorcycle-expense-tracker/', title: 'Motorcycle expense tracker', line: 'Log fill-ups and see what your petrol habit really costs per kilometre.', object: 'chart' },
        { href: '/motorcycle-renewal-reminders/', title: 'Renewal reminders', line: 'Road tax, insurance and COE renewals, flagged before they lapse.', object: 'coe' },
        { href: '/guides/petrol-prices-singapore/', title: 'Petrol prices, explained', line: 'How pump pricing works in Singapore, and what a litre buys you.', object: 'guides' },
      ]}
    />

    <FeatureFaq headline="Questions about the rider tools." questions={questions} />

    <FeatureAsk
      headline="Check the road before you roll."
      note="Causeway cameras, petrol prices and the COE calculator — in MyRideSG on iOS and Android."
    />
  </main>
  <SiteFooter />
</BaseLayout>
