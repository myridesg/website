---
import '@/styles/global.css'
import { getImage } from 'astro:assets'
import { SITE, STORE } from '@/consts'
import { buildGraph, serializeJsonLd } from '@/lib/seo'
import defaultOgSource from '@/assets/hero-carpark-desktop.jpg'

// The three faces that render above the fold: Barlow Condensed 700 for the
// hero h1 and the nav brand, Barlow 400 for the hero copy, Barlow 700 for the
// eyebrow. Their @fontsource woff2 files are declared in global.css, so the
// browser only discovers them once the (inlined) stylesheet is parsed — by
// then the fallback fonts have already painted, and the swap re-laid-out the
// hero, which measured as CLS 0.124 on mobile Lighthouse. Preloading from the
// HTML starts those fetches immediately instead, so the webfont is ready at
// first paint. The `?url` imports resolve to the same hashed _astro/*.woff2
// URLs the CSS references, so nothing is downloaded twice. Every other face —
// Barlow 500/600, Barlow Condensed 600 — is below the fold or inside hidden
// nav items and keeps its ordinary CSS-driven fetch.
import barlowCondensed700Url from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url'
import barlow400Url from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url'
import barlow700Url from '@fontsource/barlow/files/barlow-latin-700-normal.woff2?url'

interface Props {
  /** Page title. Rendered as "<title> — MyRideSG"; omit on the home page. */
  title?: string
  description?: string
  /** Absolute or root-relative path to the social image. */
  ogImage?: string
  /** Set true only on pages that must stay out of the index. */
  noindex?: boolean
  /**
   * Overrides the self-referencing canonical. Only for content that is
   * authored elsewhere and republished here — CMS-supplied canonicalUrl.
   */
  canonical?: string
  /** Page-specific schema.org entities, merged with the shared Organization and WebSite. */
  structuredData?: Record<string, unknown>[]
}

const {
  title,
  description = SITE.description,
  ogImage,
  noindex = false,
  canonical: canonicalOverride,
  structuredData = [],
} = Astro.props

/**
 * Length guidance in characters. Search engines truncate by rendered pixel
 * width, which neither characters nor bytes reproduce, so characters are used
 * because they are what authors can count. The budget only avoids a cut we did
 * not choose; it is not a ranking rule. Authored titles are never truncated
 * here — a title that overruns is fixed where it is written.
 */
const TITLE_BUDGET = 60
const DESCRIPTION_BUDGET = 160
/**
 * A sentence-boundary cut is only preferred while it still fills the snippet.
 * Some ledes open with a short hook, and stopping there would throw away half
 * the budget. Below this, the word-boundary cut wins instead.
 */
const SENTENCE_CUT_FLOOR = 120

const length = (text: string) => [...text].length

const brandSuffix = ` — ${SITE.name}`

/** The brand suffix yields first: it is dropped when it would push the title over budget. */
const pageTitle = title
  ? length(title) + length(brandSuffix) <= TITLE_BUDGET
    ? `${title}${brandSuffix}`
    : title
  : `${SITE.name} — ${SITE.tagline}`

/**
 * Guides reuse `description` twice: as the lede paragraph under the h1, and —
 * when Sanity's seo.metaDescription is empty, which today it is for every
 * article — as this tag. A lede is written to be read at full length, so some
 * run past the budget. Clamp the copy of it that goes in <head>; the visible
 * paragraph is the page's business and is left alone.
 *
 * Whole sentences first, because a description that stops at a full stop reads
 * like it was written that way rather than cut off.
 */
function clampDescription(text: string): string {
  const copy = text.trim()
  if (length(copy) <= DESCRIPTION_BUDGET) return copy

  let kept = ''
  for (const sentence of copy.split(/(?<=\.)\s+/)) {
    const candidate = kept ? `${kept} ${sentence}` : sentence
    if (length(candidate) > DESCRIPTION_BUDGET) break
    kept = candidate
  }
  if (length(kept) >= SENTENCE_CUT_FLOOR) return kept

  // Nothing usable on a sentence boundary. Cut on a word boundary, then drop a
  // trailing conjunction so it does not end on "and…". The ellipsis takes one
  // character of the budget.
  const cut = [...copy].slice(0, DESCRIPTION_BUDGET - 1).join('')
  return `${cut
    .slice(0, cut.lastIndexOf(' '))
    .replace(/[\s,;:–—-]+$/, '')
    .replace(/\s+(?:and|or|but|with|plus|as|to|for|of|in|on|at|from)$/i, '')
    .replace(/[\s,;:–—-]+$/, '')}…`
}

const metaDescription = clampDescription(description)
const canonical = canonicalOverride
  ? new URL(canonicalOverride, Astro.site).href
  : new URL(Astro.url.pathname, Astro.site).href

// Default card: the existing hero, cropped to the 1200x630 Open Graph size at
// build time. JPEG rather than WebP because social crawlers handle it reliably.
const defaultOg = ogImage
  ? undefined
  : await getImage({ src: defaultOgSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
const socialImage = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL(defaultOg!.src, Astro.site).href
const socialImageAlt = defaultOg
  ? 'A motorcycle on a Singapore carpark rooftop at night, with the city skyline behind'
  : undefined

const graph = buildGraph(Astro.site!, structuredData)

/**
 * Search-console ownership metas, supplied per environment rather than
 * committed. Read exactly the way src/lib/content.ts reads the Sanity vars:
 * shell first (CI), import.meta.env second (local .env). Rendered only when
 * set, so a build without them ships nothing extra.
 */
function envVar(name: string): string | undefined {
  return process.env[name] ?? (import.meta.env as Record<string, string | undefined>)[name]
}

const googleSiteVerification = envVar('GOOGLE_SITE_VERIFICATION')
const bingSiteVerification = envVar('BING_SITE_VERIFICATION')
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />

    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/* Preload the faces the hero and nav paint with. `crossorigin` is
        required even same-origin — font fetches are CORS-mode, and a preload
        without it never matches the CSS-initiated request. font-src 'self'
        already allows the files themselves. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href={barlowCondensed700Url} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={barlow400Url} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={barlow700Url} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171110" />
    <!-- Tells the UA to render form controls, scrollbars and the like in the
         scheme the page actually uses, rather than assuming light. -->
    <meta name="color-scheme" content="light dark" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    {/* Full copy, not the clamped one: a social card renders far more than a
        search result does, so there is nothing to gain by cutting it here. */}
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={socialImage} />
    {defaultOg && <meta property="og:image:type" content="image/jpeg" />}
    {defaultOg && <meta property="og:image:width" content="1200" />}
    {defaultOg && <meta property="og:image:height" content="630" />}
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}

    <script type="application/ld+json" is:inline set:html={serializeJsonLd(graph)} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Must run before first paint, and must stay inline and unbundled — a
        deferred module would let the light palette paint first and then swap,
        which is the flash every theme toggle is judged on. It sits after the
        theme-color tags above so ThemeToggle can find them.

        `data-js` is what reveals the toggle button. Rendering it hidden and
        showing it here means a reader with JavaScript off never sees a control
        that cannot work, and no one sees it pop in late. */}
    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem('myridesg-theme')
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored
          }
        } catch {}
        document.documentElement.dataset.js = ''
      })()
    </script>

    {/* Detaches the fragment from a cross-page anchor arrival BEFORE the target
        element is parsed, so the UA never has anything to scroll to and cannot
        paint a frame at the destination. SiteNav.astro then flies the reader
        there from the top; it reads the stashed value below instead of
        location.hash.

        This has to be inline and in <head>. SiteNav's copy is a bundled module,
        which runs after the document is parsed — in Chromium that landed before
        first paint every time, but the ordering is not guaranteed, and on a slow
        cold load of a long guide the browser could paint once at the fragment
        first. That flash is the whole bug, so the fix belongs where it cannot
        race.

        Gated identically to SiteNav's block, because a hash this script hides
        is a hash that script must be willing to use: fresh navigations only —
        back/forward and reload must land where the reader already was — and
        never under reduced motion, where the native jump is the correct
        behaviour. The navigation entry is already populated this early —
        measured at document_start with readyState "loading" — so no fallback to
        the deprecated performance.navigation is needed. */}
    <script is:inline>
      ;(() => {
        const hash = location.hash
        if (hash.length < 2) return

        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        } catch {
          return
        }

        const entry = performance.getEntriesByType('navigation')[0]
        if (entry?.type !== 'navigate') return

        window.__pendingHash = hash
        history.replaceState(history.state, '', location.pathname + location.search)
      })()
    </script>
    {/* Routes the download calls to action at the reader's own store.
        Inline and unbundled for the same reason as the theme script: the
        platform has to be on <html> before first paint, or a phone shows both
        store buttons and then drops one, which is a visible reflow directly
        under the headline.

        Detection is deliberately narrow. Only a phone or tablet we can name
        gets routed; everything else — desktop, an unknown UA, a crawler, or
        JavaScript switched off — keeps both buttons, which is the honest
        default rather than a degraded one. iPadOS reports itself as a Mac, so
        the touch check is what separates it from a desktop Safari that should
        keep seeing both.

        The href rewrite waits for DOMContentLoaded because those links do not
        exist yet. A click landing before then falls through to the page's own
        download section, which is the right destination anyway. */}
    <script is:inline define:vars={{ STORE }}>
      ;(() => {
        const ua = navigator.userAgent
        const platform = /iPad|iPhone|iPod/.test(ua) || (ua.includes('Mac') && 'ontouchend' in document)
          ? 'ios'
          : /Android/.test(ua)
            ? 'android'
            : ''

        if (!platform) return
        document.documentElement.dataset.platform = platform

        const href = platform === 'ios' ? STORE.ios : STORE.android
        addEventListener('DOMContentLoaded', () => {
          for (const link of document.querySelectorAll('[data-store-link]')) {
            link.href = href
          }
        })
      })()
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <slot />
  </body>
</html>

<style is:global>
  /* Sticky footer. Every page passes the same three children into the slot —
     SiteNav, a <main>, then SiteFooter — so this belongs here rather than being
     repeated on each page.

     SiteNav is position:fixed and so contributes no flow height; the column
     only has to divide the viewport between <main> and the footer, which is why
     a bare min-h-dvh on <body> is enough and no header offset is needed.

     flex-grow on its own, keeping the default `auto` basis, rather than
     `flex: 1`: <main> stays sized by its own content and only absorbs space
     that is left over once min-height stretches <body> past it. A page taller
     than the viewport lays out exactly as it did before. */
  body > main {
    flex-grow: 1;
  }

  /* The other half of the platform routing in <head>. Done in CSS rather than
     by removing the node, so the markup a crawler sees is the full pair and
     the decision is presentational — which is what it is. Neither rule matches
     until the script sets the attribute, so the no-JS default is both. */
  html[data-platform='ios'] [data-store='android'],
  html[data-platform='android'] [data-store='ios'] {
    display: none;
  }
</style>
