---
import BaseLayout from './BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import GuideNav from '@/components/ui/guide/GuideNav.astro'
import GuideCover from '@/components/ui/guide/GuideCover.astro'
import GuideByline from '@/components/ui/guide/GuideByline.astro'
import GuideTags from '@/components/ui/guide/GuideTags.astro'
import GuideShare from '@/components/ui/guide/GuideShare.astro'
import FeatureAsk from '@/components/ui/feature/FeatureAsk.astro'
import { GUIDE_GROUPS, topicPath, type GuideGroupId } from '@/lib/guide-navigation'
import type { GuideEntry } from '@/lib/guides'
import type { GuideTag } from '@/lib/guide-tags'
import { parsePhotoCredit } from '@/lib/photo-credit'
import { forBuild } from '@/lib/build-image'
import '@/styles/guides.css'

/**
 * The guide article's page: the topic bar, a picture (with its caption and
 * credit when it is a photo), two tags, the title and the byline in a wide
 * head, then the text in a narrower column under it, ending on the article's
 * tags and the share links. The default slot is the body; "after" is whatever
 * follows the text (more guides). The page ends on the closing band.
 */
interface Props {
  guide: GuideEntry
  /** Topics that have guides, for the bar. */
  topics: GuideGroupId[]
  /** Document <title> when it differs from the h1 (a CMS metaTitle). */
  seoTitle?: string
  description: string
  noindex?: boolean
  canonical?: string
  /** The address to share: the canonical one, absolute. */
  shareUrl: string
  /** The article's tags that have a page of their own. */
  tags: GuideTag[]
  structuredData?: Record<string, unknown>[]
}

const { guide, topics, seoTitle, description, noindex, canonical, shareUrl, tags, structuredData } = Astro.props
const { article, topic, cover, readMinutes } = guide
const photo = article.heroImage
const credit = photo?.credit ? parsePhotoCredit(photo.credit) : null
const caption = photo?.caption ?? null
const group = GUIDE_GROUPS.find((g) => g.id === topic)!
const name = article.author.name.trim() && article.author.name !== 'Unknown' ? article.author.name : null
---

<BaseLayout
  title={seoTitle ?? article.title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  structuredData={structuredData}
  headerTone="deep"
  ogImage={photo ? { src: forBuild(photo).src, alt: photo.alt } : undefined}
  article={{
    published: article.publishedAt,
    modified: article.updatedAt,
    section: group.label,
    tags: article.tags,
  }}
>
  <SiteNav />

  <main class="feature-page guides-page guide-article">
    <GuideNav topics={topics} within={topic} />

    <header class="guide-head">
      <figure class="guide-head__picture">
        <GuideCover cover={cover} photo={photo} size="hero" eager />
        {(caption || credit) && (
          <figcaption class="guide-head__credit">
            {caption && <span class="guide-head__caption">{caption}</span>}
            {caption && credit && ' · '}
            {credit && (
              <>
                Photo: {photo?.sourceUrl ? <a href={photo.sourceUrl} rel="noopener">{credit.author}</a> : credit.author}
                {credit.licence && (
                  <>
                    , <a href={credit.licence.url} rel="license noopener">{credit.licence.name}</a>
                  </>
                )}
                {credit.rest}
                {credit.licence && ', cropped'}
              </>
            )}
          </figcaption>
        )}
      </figure>
      <div class="guide-head__tags">
        <a href="/guides/">Guides</a>
        {topics.includes(topic) ? <a href={topicPath(topic)}>{group.label}</a> : <span>{group.label}</span>}
      </div>
      <h1 class="guide-head__title">{article.title}</h1>
      <GuideByline
        name={name}
        published={article.publishedAt}
        updated={article.updatedAt}
        readMinutes={readMinutes}
        size="article"
      />
    </header>

    <article class="guide-text">
      <p class="guide-text__lead">{article.description}</p>
      <slot />
      <footer class="guide-end" data-guide-end>
        <GuideTags tags={tags} />
        <GuideShare url={shareUrl} title={article.title} />
      </footer>
    </article>

    <slot name="after" />

    <FeatureAsk
      headline="Keep your motorcycle records close."
      note="Log services, fuel and renewal dates in MyRideSG on iOS or Android."
    />
  </main>

  <SiteFooter />
</BaseLayout>
