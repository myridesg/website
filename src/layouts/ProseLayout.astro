---
import BaseLayout from './BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro'

interface Props {
  title: string
  description?: string
  /** Rendered under the h1, e.g. "Last updated: 6 August 2026". */
  meta?: string
  /**
   * Document <title> when it must differ from the h1 — a CMS metaTitle written
   * for search results rather than for the top of the page. Defaults to title.
   */
  seoTitle?: string
  noindex?: boolean
  canonical?: string
  breadcrumbs?: Array<{ name: string; href?: string }>
  structuredData?: Record<string, unknown>[]
}

const { title, description, meta, seoTitle, noindex, canonical, breadcrumbs, structuredData } =
  Astro.props
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  structuredData={structuredData}
>
  <SiteNav />

  <main class="bg-paper pb-24 pt-32 md:pt-40">
    <div class="shell">
      <article class="prose-body mx-auto max-w-[46rem]">
        {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
        <h1 class="text-display-sm md:text-display">{title}</h1>
        {meta && <p class="mt-3 text-sm text-muted">{meta}</p>}
        <slot name="meta" />

        <div class="mt-10">
          <slot />
        </div>
      </article>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style is:global>
  /* Scoped to prose pages so the long-form legal and guide content gets sane
     vertical rhythm without every element needing a utility class. */
  .prose-body h2 {
    font-size: var(--text-2xl);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .prose-body h3 {
    font-size: var(--text-xl);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .prose-body p,
  .prose-body ul,
  .prose-body ol {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .prose-body ul,
  .prose-body ol {
    padding-left: 1.25rem;
  }

  .prose-body ul {
    list-style: disc;
  }

  .prose-body ol {
    list-style: decimal;
  }

  .prose-body li {
    margin-bottom: 0.375rem;
  }

  .prose-body strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .prose-body a {
    color: var(--color-red);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose-body a:hover {
    text-decoration-thickness: 2px;
  }
</style>
