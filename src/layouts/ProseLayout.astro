---
import BaseLayout from './BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import PageHead from '@/components/ui/PageHead.astro'
import '@/styles/reading.css'

/**
 * Long-form pages (guides, support, delete account, privacy, terms) in the
 * studio look: PageHead on the wall, then the reading column on a white
 * panel standing on the studio floor. Styles in reading.css.
 *
 * Slots: the default slot is the text; "meta" is PageHead's meta line when
 * it needs markup; "after" is anything that follows the panel as a band of
 * its own (questions, the dark finale).
 */
interface Props {
  title: string
  description?: string
  /** Under the headline, in the opening. */
  lead?: string
  /** Rendered under the h1, e.g. "Last updated: 6 August 2026". */
  meta?: string
  /**
   * Document <title> when it must differ from the h1 — a CMS metaTitle written
   * for search results rather than for the top of the page. Defaults to title.
   */
  seoTitle?: string
  noindex?: boolean
  canonical?: string
  /** The eyebrow trail; defaults to Home and the page's title. */
  breadcrumbs?: Array<{ name: string; href?: string }>
  structuredData?: Record<string, unknown>[]
}

const { title, description, lead, meta, seoTitle, noindex, canonical, breadcrumbs, structuredData } =
  Astro.props
const crumbs = breadcrumbs ?? [{ name: 'Home', href: '/' }, { name: title }]
const metaHtml = Astro.slots.has('meta') ? await Astro.slots.render('meta') : undefined
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  structuredData={structuredData}
>
  <SiteNav />

  <main class="feature-page">
    <PageHead crumbs={crumbs} title={title} lead={lead} meta={meta}>
      {metaHtml && <Fragment slot="meta" set:html={metaHtml} />}
    </PageHead>

    <div class="reading">
      <article class="reading__panel prose-body">
        <slot />
      </article>
    </div>

    <slot name="after" />
  </main>

  <SiteFooter />
</BaseLayout>
